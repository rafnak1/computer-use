for _n in range(1, 25):
    KEY_ALIASES["f%d" % _n] = "F%d" % _n

SHIFT_KEYSYM = 0xFFE1
CONTROL_KEYSYM = 0xFFE3
RETURN_KEYSYM = 0xFF0D
TAB_KEYSYM = 0xFF09


def char_keysym(ch):
    """Keysym for a single character (Latin-1 direct, else Unicode keysym)."""
    cp = ord(ch)
    if ch == "\n":
        return RETURN_KEYSYM
    if ch == "\t":
        return TAB_KEYSYM
    if 0x20 <= cp <= 0x7E or 0xA0 <= cp <= 0xFF:
        return cp
    return 0x01000000 | cp


NO_SYMBOL = 0
# Core modifier-state bits that would change what a typed key produces.
BLOCKING_STATE = (("Shift", 0x01), ("Caps Lock", 0x02), ("Control", 0x04),
                  ("Alt (Mod1)", 0x08), ("Super (Mod4)", 0x40))
XKB_GROUP_MASK = 0x6000


def text_keysyms(text):
    """Keysyms for literal text; rejects characters no key can produce."""
    out = []
    for i, ch in enumerate(text):
        cp = ord(ch)
        if ch == "\r":
            continue
        if (cp < 0x20 and ch not in "\n\t") or 0x7F <= cp <= 0x9F:
            raise usage_error("text contains control character U+%04X at index %d" % (cp, i))
        if 0xD800 <= cp <= 0xDFFF:
            raise usage_error("text contains an unpaired surrogate U+%04X at index %d" % (cp, i),
                              "pass valid UTF-8 text")
        out.append(char_keysym(ch))
    return out


def blocking_state(mask):
    """Names of active modifiers/groups that would garble typed text."""
    names = [name for name, bit in BLOCKING_STATE if mask & bit]
    if mask & XKB_GROUP_MASK:
        names.append("keyboard group %d" % (((mask & XKB_GROUP_MASK) >> 13) + 1))
    return names


def strip_row(row):
    """Keysym row without trailing NoSymbol padding."""
    row = list(row)
    while row and row[-1] == NO_SYMBOL:
        row.pop()
    return tuple(row)


def row_signature(row):
    """The set of keysyms in a row."""
    return frozenset(ks for ks in row if ks != NO_SYMBOL)


def scratch_row_matches(current, recorded):
    """Whether keycode row `current` is the one we recorded.

    Rows are compared exactly (ignoring trailing NoSymbol). The server (XKB)
    rewrites core rows we install, e.g. [e, e] reads back as [e, NoSymbol, e];
    for a recorded install row [ks, ks] we also accept any row that starts
    with ks and holds nothing but ks, which covers a crash before the
    server's actual row was read back and journaled.
    """
    cur, rec = strip_row(current), strip_row(recorded)
    if cur == rec:
        return True
    return (len(rec) == 2 and rec[0] == rec[1] and bool(cur) and cur[0] == rec[0]
            and row_signature(cur) == {rec[0]})


def core_level_matches(row, level, keysym):
    """Whether a core keymap row has keysym at group 1, `level` (0 or 1)."""
    return len(row) > level and row[level] == keysym


def find_scratch_keycodes(rows, exclude=()):
    """Keycodes with no keysyms at all, highest first, minus excluded ones."""
    return sorted((kc for kc, row in rows.items()
                   if kc >= 8 and kc not in exclude and not strip_row(row)), reverse=True)


def plan_typing(keysyms, direct, capacity):
    """Split keysyms into batches of (scratch assignment, steps).

    direct maps keysym -> (keycode, needs_shift) for keys on the layout. Other
    keysyms get a scratch slot; a batch never needs more than `capacity`
    slots. Steps are ("key", keycode, needs_shift) or ("scratch", slot).
    """
    batches, assign, steps = [], [], []
    for ks in keysyms:
        if ks in direct:
            kc, shift = direct[ks]
            steps.append(("key", kc, shift))
            continue
        if ks not in assign:
            if capacity <= 0:
                raise CuError("no_scratch_keycode",
                              "no unused keycode is free to type characters missing from the keyboard layout",
                              "free a keycode (e.g. remove an unused binding with xmodmap) or type only "
                              "characters on the current layout")
            if len(assign) == capacity:
                batches.append((assign, steps))
                assign, steps = [], []
            assign.append(ks)
        steps.append(("scratch", assign.index(ks)))
    if steps:
        batches.append((assign, steps))
    return batches


def keymap_state_paths():
    """(lock path, journal path) for this user and display."""
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    tag = re.sub(r"[^A-Za-z0-9.]+", "_", display_name())
    stem = os.path.join(base, "cu-keymap-%d-%s" % (os.getuid(), tag))
    return stem + ".lock", stem + ".json"


def _check_private_file(fd, path):
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise CuError("keymap_lock", "refusing to use %s: not a private regular file owned by you" % path,
                      "remove it or set XDG_RUNTIME_DIR to a private directory")


class ScratchKeys:
    """Temporarily bind keysyms to unused keycodes, restoring them afterwards.

    A display-scoped lock serialises cooperating cu processes. A journal next
    to it records, before every change, each row a keycode may hold, so a run
    killed mid-typing is cleaned up by the next one. Only keycodes whose
    current row is one we installed are reset; anything else is reported.
    """

    def __init__(self, xd):
        self.xd = xd
        self.fd = None
        self.slots = []
        self.rows = {}
        self.installed = {}  # keycode -> [rows it may hold because of us]
        self.conflicts = []
        self.restore_failed = False

    def __enter__(self):
        self._lock()
        try:
            self._recover()
            kmin, kmax, width, self.rows = self.xd.keyboard_mapping()
            self.width = max(width, 2)
            exclude = self.xd.modifier_keycodes() | self.xd.pressed_keycodes()
            self.slots = find_scratch_keycodes(self.rows, exclude)
        except BaseException:
            self._unlock()
            raise
        return self

    def __exit__(self, *exc):
        try:
            self.restore()
        finally:
            self._unlock()
        return False

    # --- lock and journal -----------------------------------------------

    def _lock(self):
        path, self.journal = keymap_state_paths()
        try:
            self.fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0), 0o600)
        except OSError as exc:
            raise CuError("keymap_lock", "cannot open keymap lock %s: %s" % (path, exc.strerror or exc))
        try:
            _check_private_file(self.fd, path)
            deadline = time.monotonic() + KEYMAP_LOCK_TIMEOUT
            while True:
                try:
                    fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    return
                except OSError as exc:
                    if exc.errno not in (errno.EAGAIN, errno.EACCES) or time.monotonic() > deadline:
                        raise CuError("keymap_busy", "another cu process is typing on this display",
                                      "retry when it finishes")
                    time.sleep(0.05)
        except BaseException:
            self._unlock()
            raise

    def _unlock(self):
        if self.fd is not None:
            os.close(self.fd)  # releases the flock
            self.fd = None

    def _save(self):
        """Atomically replace the journal with the current candidate rows."""
        data = json.dumps({"pid": os.getpid(),
                           "keys": {str(k): [list(r) for r in v] for k, v in self.installed.items()}})
        fd, tmp = tempfile.mkstemp(prefix=".cu-keymap-", dir=os.path.dirname(self.journal))
        try:
            with os.fdopen(fd, "w") as fh:
                fh.write(data)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, self.journal)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise

    def _recover(self):
        try:
            fd = os.open(self.journal, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
        except FileNotFoundError:
            return
        except OSError as exc:
            raise CuError("keymap_lock", "cannot open keymap journal %s: %s" % (self.journal, exc.strerror or exc))
        try:
            _check_private_file(fd, self.journal)
            with os.fdopen(fd, "rb", closefd=False) as fh:
                raw = fh.read()
        finally:
            os.close(fd)
        try:
            keys = json.loads(raw.decode()).get("keys", {})
            self.installed = {int(k): [tuple(int(x) for x in r) for r in v] for k, v in keys.items()}
        except (ValueError, AttributeError, TypeError):
            self.installed = {}
        self.restore(settle=False)

    # --- mapping changes ------------------------------------------------

    def _ours(self, kc, current):
        """Whether keycode kc currently holds nothing or a row we installed."""
        return (not row_signature(current)
                or any(scratch_row_matches(current, r) for r in self.installed.get(kc, ())))

    def assign(self, keysyms):
        """Bind keysyms[i] to self.slots[i]; settles before and after."""
        if self.installed:
            time.sleep(KEYMAP_SETTLE)  # let clients translate keys already sent
        changes = []
        for i, ks in enumerate(keysyms):
            kc = self.slots[i]
            row = tuple([ks, ks] + [NO_SYMBOL] * (self.width - 2))
            current = self.xd.keycode_row(kc)
            if not self._ours(kc, current):
                self.installed.pop(kc, None)
                self.conflicts.append(kc)
                raise CuError("keymap_conflict",
                              "keycode %d was changed by another program while typing" % kc,
                              "part of the text may have been typed; check and retry", keymap_conflicts=[kc])
            if not scratch_row_matches(current, row):
                changes.append((kc, row))
        if not changes:
            return
        for kc, row in changes:  # journal old and new rows before mutating
            self.installed.setdefault(kc, [])
            if row not in self.installed[kc]:
                self.installed[kc].append(row)
        self._save()
        before = len(self.xd._errors)
        for kc, row in changes:
            self.xd.set_keycode_row(kc, row)
        self.xd.sync()
        if len(self.xd._errors) != before:  # keep every candidate row for cleanup
            raise CuError("keymap_change_failed", "the X server rejected a keyboard mapping change")
        for kc, row in changes:
            actual = self.xd.keycode_row(kc)  # the server's rewritten form of our row
            if not scratch_row_matches(actual, row):
                if kc not in self.conflicts:
                    self.conflicts.append(kc)
                raise CuError("keymap_conflict",
                              "keycode %d was changed by another program while typing" % kc,
                              "part of the text may have been typed; check and retry", keymap_conflicts=[kc])
            self.installed[kc] = [row] if strip_row(actual) == strip_row(row) else [row, tuple(actual)]
        self._save()
        time.sleep(KEYMAP_SETTLE)

    def restore(self, settle=True):
        if not self.installed:
            return
        if settle:
            time.sleep(KEYMAP_SETTLE)
        before = len(self.xd._errors)
        for kc, rows in sorted(self.installed.items()):
            current = self.xd.keycode_row(kc)
            if not row_signature(current):
                continue
            if self._ours(kc, current):
                self.xd.set_keycode_row(kc, (NO_SYMBOL,) * max(len(current), 2))
            elif kc not in self.conflicts:
                self.conflicts.append(kc)  # someone else changed it; leave theirs alone
        self.xd.sync()
        if len(self.xd._errors) != before:
            self.restore_failed = True  # keep the journal so the next run retries
            return
        self.installed = {}
        self._save()


def parse_chord(spec):
    """Split a chord into (modifier keysym names, key token).

    Returns a list of tokens; validation of names happens in resolve_token.
    "ctrl++" means ctrl and the plus key.
    """
    if not isinstance(spec, str) or not spec.strip():
        raise usage_error("key chord must be a non-empty string", "example: ctrl+l")
    spec = spec.strip()
    if spec == "+":
        return ["+"]
    if spec.endswith("++"):
        parts = spec[:-2].split("+") + ["+"]
    else:
        parts = spec.split("+")
    if any(p.strip() == "" for p in parts):
        raise usage_error("malformed key chord %r" % spec, "join key names with '+', e.g. ctrl+shift+Tab")
    return [p.strip() for p in parts]


# ---------------------------------------------------------------------------
# PNG / XWD
# ---------------------------------------------------------------------------

def png_bytes(width, height, rgb_rows):
    """Encode an RGB image (iterable of row bytes) as PNG."""
    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)

    raw = bytearray()
    for row in rgb_rows:
        raw.append(0)
        raw += row
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr)
            + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b""))


def _mask_shift(mask):
    if mask == 0:
        return 0, 0
    shift = (mask & -mask).bit_length() - 1
    width = (mask >> shift).bit_length()
    return shift, width


def xwd_to_rgb(data):
    """Parse an XWD (X Window Dump, version 7) ZPixmap image.

    Returns (width, height, list_of_rgb_row_bytes).
    """
    if len(data) < 100:
        raise CuError("screenshot_failed", "xwd output is truncated")
    fields = struct.unpack(">25I", data[:100])
    (header_size, version, fmt, depth, width, height, _xoff, byte_order,
     _bunit, _bbo, _bpad, bpp, bpl, vclass, rmask, gmask, bmask, _bits_rgb,
     _cmap_entries, ncolors) = fields[:20]
    if version != 7:
        raise CuError("screenshot_failed", "unsupported XWD version %d" % version)
    if fmt != 2:
        raise CuError("screenshot_failed", "unsupported XWD pixmap format %d (expected ZPixmap)" % fmt)
    if width == 0 or height == 0 or width > 65535 or height > 65535:
        raise CuError("screenshot_failed", "invalid XWD dimensions %dx%d" % (width, height))
    if bpp not in (8, 16, 24, 32) or bpl < (width * bpp + 7) // 8:
        raise CuError("screenshot_failed", "unsupported XWD layout (bpp=%d, bytes_per_line=%d)" % (bpp, bpl))
    cmap_off = header_size
    pix_off = cmap_off + ncolors * 12
    need = pix_off + bpl * height
    if len(data) < need:
        raise CuError("screenshot_failed", "xwd output is truncated (%d < %d bytes)" % (len(data), need))

    colormap = {}
    for i in range(ncolors):
        pixel, r, g, b = struct.unpack(">IHHH", data[cmap_off + i * 12: cmap_off + i * 12 + 10])
        colormap[pixel] = (r >> 8, g >> 8, b >> 8)

    bypp = bpp // 8
    pix = memoryview(data)[pix_off:need]
    rows = []
    truecolor = vclass in (4, 5) and rmask and gmask and bmask  # TrueColor / DirectColor

    # Fast path: 24/32 bpp with byte-aligned 8-bit channels.
    if truecolor and bypp in (3, 4):
        offsets = []
        for mask in (rmask, gmask, bmask):
            shift, w = _mask_shift(mask)
            if w != 8 or shift % 8:
                offsets = None
                break
            idx = shift // 8
            offsets.append(idx if byte_order == 0 else bypp - 1 - idx)
        if offsets:
            ro, go, bo = offsets
            row_len = width * bypp
            for y in range(height):
                src = pix[y * bpl: y * bpl + row_len]
                out = bytearray(width * 3)
                out[0::3] = src[ro::bypp]
                out[1::3] = src[go::bypp]
                out[2::3] = src[bo::bypp]
                rows.append(bytes(out))
            return width, height, rows

    # Generic path (slow but complete).
    endian = "little" if byte_order == 0 else "big"
    if truecolor:
        chans = [_mask_shift(m) for m in (rmask, gmask, bmask)]
    for y in range(height):
        base = y * bpl
        out = bytearray(width * 3)
        for x in range(width):
            o = base + x * bypp
            value = int.from_bytes(pix[o:o + bypp], endian)
            if truecolor:
                rgb = []
                for (shift, w) in chans:
                    v = (value >> shift) & ((1 << w) - 1)
                    rgb.append((v * 255) // ((1 << w) - 1) if w else 0)
            else:
                rgb = colormap.get(value, (0, 0, 0))
            out[x * 3: x * 3 + 3] = bytes(rgb)
        rows.append(bytes(out))
    return width, height, rows


# ---------------------------------------------------------------------------
# X11 access
# ---------------------------------------------------------------------------

def display_name():
    return os.environ.get("DISPLAY") or ":0"


def display_hint():
    return ("Check that an unlocked X11 session is running on DISPLAY=%s and that "
            "XAUTHORITY grants access. Sandboxed agents must run desktop commands "
            "with escalated/unsandboxed permissions." % display_name())


_X_ERROR_HANDLER_TYPE = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)


class _XModifierKeymap(ctypes.Structure):
    _fields_ = [("max_keypermod", ctypes.c_int), ("modifiermap", ctypes.POINTER(ctypes.c_ubyte))]


class XDisplay:
    """Thin ctypes wrapper over libX11 + libXtst."""

    def __init__(self):
        self.x11 = self._load("X11", "libX11.so.6")
        self.xtst = self._load("Xtst", "libXtst.so.6")
        self._declare()
        self._errors = []
        self._held = []
        self._buttons_held = []
        self.dpy = None

        def _handler(_dpy, _event):
            self._errors.append(True)
            return 0

        self._handler = _X_ERROR_HANDLER_TYPE(_handler)  # keep a reference
        self.x11.XSetErrorHandler(self._handler)
        name = display_name()
        self.dpy = self.x11.XOpenDisplay(name.encode())
        if not self.dpy:
            raise CuError("display_unavailable", "cannot open X display %s" % name, display_hint())
        ev = ctypes.c_int()
        err = ctypes.c_int()
        maj = ctypes.c_int()
        mnr = ctypes.c_int()
        if not self.xtst.XTestQueryExtension(self.dpy, ctypes.byref(ev), ctypes.byref(err),
                                             ctypes.byref(maj), ctypes.byref(mnr)):
            self.close()
            raise CuError("xtest_unavailable", "the X server lacks the XTEST extension")
        self.screen = self.x11.XDefaultScreen(self.dpy)
        self.root = self.x11.XRootWindow(self.dpy, self.screen)
        self.width = self.x11.XDisplayWidth(self.dpy, self.screen)
        self.height = self.x11.XDisplayHeight(self.dpy, self.screen)

    @staticmethod
    def _load(short, soname):
        path = ctypes.util.find_library(short) or soname
        try:
            return ctypes.CDLL(path)
        except OSError as exc:
            raise CuError("library_missing", "cannot load %s (%s)" % (soname, exc),
                          "install the lib%s runtime library" % short)

    def _declare(self):
        x, t = self.x11, self.xtst
        vp, ul, ci, cu, cb = ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_uint, ctypes.c_ubyte
        P = ctypes.POINTER
        x.XSetErrorHandler.argtypes = [_X_ERROR_HANDLER_TYPE]
        x.XSetErrorHandler.restype = vp
        x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x.XOpenDisplay.restype = vp
        x.XCloseDisplay.argtypes = [vp]
        x.XDefaultScreen.argtypes = [vp]
        x.XDefaultScreen.restype = ci
        x.XRootWindow.argtypes = [vp, ci]
        x.XRootWindow.restype = ul
        x.XDisplayWidth.argtypes = [vp, ci]
        x.XDisplayWidth.restype = ci
        x.XDisplayHeight.argtypes = [vp, ci]
        x.XDisplayHeight.restype = ci
        x.XFlush.argtypes = [vp]
        x.XSync.argtypes = [vp, ci]
        x.XStringToKeysym.argtypes = [ctypes.c_char_p]
        x.XStringToKeysym.restype = ul
        x.XKeysymToKeycode.argtypes = [vp, ul]
        x.XKeysymToKeycode.restype = cb
        x.XkbKeycodeToKeysym.argtypes = [vp, cb, ci, ci]
        x.XkbKeycodeToKeysym.restype = ul
        x.XDisplayKeycodes.argtypes = [vp, P(ci), P(ci)]
        x.XGetKeyboardMapping.argtypes = [vp, cu, ci, P(ci)]
        x.XGetKeyboardMapping.restype = P(ul)
        x.XChangeKeyboardMapping.argtypes = [vp, ci, ci, P(ul), ci]
        x.XGetModifierMapping.argtypes = [vp]
        x.XGetModifierMapping.restype = P(_XModifierKeymap)
        x.XFreeModifiermap.argtypes = [P(_XModifierKeymap)]
        x.XQueryKeymap.argtypes = [vp, ctypes.c_char * 32]
        x.XFree.argtypes = [vp]
        x.XQueryPointer.argtypes = [vp, ul, P(ul), P(ul), P(ci), P(ci), P(ci), P(ci), P(cu)]
        x.XQueryPointer.restype = ci
        x.XGetGeometry.argtypes = [vp, ul, P(ul), P(ci), P(ci), P(cu), P(cu), P(cu), P(cu)]
        x.XGetGeometry.restype = ci
        x.XTranslateCoordinates.argtypes = [vp, ul, ul, ci, ci, P(ci), P(ci), P(ul)]
        x.XTranslateCoordinates.restype = ci
        t.XTestQueryExtension.argtypes = [vp, P(ci), P(ci), P(ci), P(ci)]
        t.XTestQueryExtension.restype = ci
        t.XTestFakeKeyEvent.argtypes = [vp, cu, ci, ul]
        t.XTestFakeButtonEvent.argtypes = [vp, cu, ci, ul]
        t.XTestFakeMotionEvent.argtypes = [vp, ci, ci, ci, ul]

    def close(self):
        if getattr(self, "dpy", None):
            self.release_all()
            self.x11.XCloseDisplay(self.dpy)
            self.dpy = None

    def sync(self):
        self.x11.XSync(self.dpy, 0)

    # --- queries ---------------------------------------------------------

    def pointer(self):
        root, child = ctypes.c_ulong(), ctypes.c_ulong()
        rx, ry, wx, wy = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
        mask = ctypes.c_uint()
        self.x11.XQueryPointer(self.dpy, self.root, ctypes.byref(root), ctypes.byref(child),
                               ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx),
                               ctypes.byref(wy), ctypes.byref(mask))
        return {"x": rx.value, "y": ry.value}

    def window_geometry(self, wid):
        root = ctypes.c_ulong()
        x, y = ctypes.c_int(), ctypes.c_int()
        w, h, bw, depth = ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint()
        before = len(self._errors)
        ok = self.x11.XGetGeometry(self.dpy, wid, ctypes.byref(root), ctypes.byref(x), ctypes.byref(y),
                                   ctypes.byref(w), ctypes.byref(h), ctypes.byref(bw), ctypes.byref(depth))
        self.sync()
        if not ok or len(self._errors) != before:
            return None
        ax, ay, child = ctypes.c_int(), ctypes.c_int(), ctypes.c_ulong()
        self.x11.XTranslateCoordinates(self.dpy, wid, self.root, 0, 0, ctypes.byref(ax),
                                       ctypes.byref(ay), ctypes.byref(child))
        self.sync()
        if len(self._errors) != before:
            return None
        return {"x": ax.value, "y": ay.value, "width": w.value, "height": h.value}

    # --- keyboard ----------------------------------------------------------

    def keysym_for_token(self, token):
        """Resolve a chord token to (keysym, is_modifier) or raise."""
        low = token.lower()
        if low in MODIFIERS:
            name = MODIFIERS[low]
            return self.x11.XStringToKeysym(name.encode()), True
        name = KEY_ALIASES.get(low, token)
        ks = 0
        if len(name) == 1:
            ks = char_keysym(name)
        else:
            ks = self.x11.XStringToKeysym(name.encode())
            if not ks:
                # case-insensitive retry for names like "pagedown" -> already aliased; try capitalized
                ks = self.x11.XStringToKeysym(name.capitalize().encode())
        if not ks:
            raise usage_error("unknown key name %r" % token,
                              "use X keysym names such as Return, Escape, Tab, Left, F5, a, ctrl, shift, alt, super")
        return ks, False

    def keycode_levels(self, keysym):
        """Return (keycode, needs_shift) for keysym, or (0, False) when not mapped."""
        kc = self.x11.XKeysymToKeycode(self.dpy, keysym)
        if not kc:
            return 0, False
        if self.x11.XkbKeycodeToKeysym(self.dpy, kc, 0, 0) == keysym:
            return kc, False
        if self.x11.XkbKeycodeToKeysym(self.dpy, kc, 0, 1) == keysym:
            return kc, True
        # Keysym lives on another group/level; letters still map sensibly.
        return kc, False

    def _key(self, keycode, press):
        if press:
            self._held.append(keycode)  # track first so cleanup covers an interrupted press
        self.xtst.XTestFakeKeyEvent(self.dpy, keycode, 1 if press else 0, 0)
        if not press and keycode in self._held:
            self._held.remove(keycode)

    def release_all(self):
        if not self.dpy:
            return
        for kc in reversed(list(self._held)):
            self.xtst.XTestFakeKeyEvent(self.dpy, kc, 0, 0)
        self._held = []
        for number in reversed(list(self._buttons_held)):
            self.xtst.XTestFakeButtonEvent(self.dpy, number, 0, 0)
        self._buttons_held = []
        self.x11.XFlush(self.dpy)

    def tap(self, keycodes):
        """Press keycodes in order, release in reverse."""
        try:
            for kc in keycodes:
                self._key(kc, True)
                self.x11.XFlush(self.dpy)
                time.sleep(KEY_DELAY)
            for kc in reversed(keycodes):
                self._key(kc, False)
                self.x11.XFlush(self.dpy)
                time.sleep(KEY_DELAY)
        finally:
            self.release_all()

    def resolve_chord(self, spec):
        tokens = parse_chord(spec)
        resolved = [(tok,) + self.keysym_for_token(tok) for tok in tokens]  # validate names first
        mods = [r for r in resolved if r[2]]
        keys = [r for r in resolved if not r[2]]
        if len(keys) > 1:
            raise usage_error("chord %r has more than one non-modifier key" % spec,
                              "send separate `key` commands for a sequence")
        codes = []
        has_shift = any(r[1] == SHIFT_KEYSYM for r in mods)
        for tok, ks, _ in mods:
            kc, _ = self.keycode_levels(ks)
            if not kc:
                raise CuError("key_unmapped", "modifier %r has no keycode in the current layout" % tok)
            if kc not in codes:
                codes.append(kc)
        for tok, ks, _ in keys:
            kc, needs_shift = self.keycode_levels(ks)
            if not kc:
                raise CuError("key_unmapped", "key %r has no keycode in the current keyboard layout" % tok,
                              "for literal characters use `cu type`")
            is_letter = len(tok) == 1 and tok.isalpha()
            if needs_shift and not has_shift and not is_letter:
                codes.append(self.keycode_levels(SHIFT_KEYSYM)[0])
            codes.append(kc)
        return codes

    def press_chord(self, spec):
        self.tap(self.resolve_chord(spec))

    def keycode_range(self):
        kmin, kmax = ctypes.c_int(), ctypes.c_int()
        self.x11.XDisplayKeycodes(self.dpy, ctypes.byref(kmin), ctypes.byref(kmax))
        return kmin.value, kmax.value

    def keyboard_mapping(self, first=None, count=None):
        """(min, max, keysyms_per_keycode, {keycode: row}) from the core keymap."""
        kmin, kmax = self.keycode_range()
        first = kmin if first is None else first
        count = kmax - first + 1 if count is None else count
        width = ctypes.c_int()
        ptr = self.x11.XGetKeyboardMapping(self.dpy, first, count, ctypes.byref(width))
        if not ptr:
            raise CuError("keymap_unavailable", "cannot read the keyboard mapping")
        try:
            w = width.value
            rows = {first + i: tuple(ptr[i * w + j] for j in range(w)) for i in range(count)}
        finally:
            self.x11.XFree(ptr)
        return kmin, kmax, w, rows

    def keycode_row(self, kc):
        return self.keyboard_mapping(kc, 1)[3][kc]

    def set_keycode_row(self, kc, row):
        arr = (ctypes.c_ulong * len(row))(*row)
        self.x11.XChangeKeyboardMapping(self.dpy, kc, len(row), arr, 1)

    def modifier_keycodes(self):
        mm = self.x11.XGetModifierMapping(self.dpy)
        if not mm:
            return set()
        try:
            n = mm.contents.max_keypermod * 8
            return {mm.contents.modifiermap[i] for i in range(n)} - {0}
        finally:
            self.x11.XFreeModifiermap(mm)

    def pressed_keycodes(self):
        buf = (ctypes.c_char * 32)()
        self.x11.XQueryKeymap(self.dpy, buf)
        return {i * 8 + b for i, byte in enumerate(buf.raw) for b in range(8) if byte & (1 << b)}

    def modifier_mask(self):
        root, child = ctypes.c_ulong(), ctypes.c_ulong()
        rx, ry, wx, wy = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
        mask = ctypes.c_uint()
        self.x11.XQueryPointer(self.dpy, self.root, ctypes.byref(root), ctypes.byref(child),
                               ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx),
                               ctypes.byref(wy), ctypes.byref(mask))
        return mask.value

    def direct_keysyms(self, rows):
        """keysym -> (keycode, needs_shift) for group 1, levels 1-2.

        Uses the XKB view, but only keeps keys whose freshly read core row
        (`rows`, columns 0-1 = group 1 levels 1-2) agrees at the same level:
        Xlib's cached XKB map can lag behind a recent mapping change.
        """
        found = {}
        for level in (0, 1):
            for kc in sorted(rows):
                ks = self.x11.XkbKeycodeToKeysym(self.dpy, kc, 0, level)
                if ks and ks not in found and core_level_matches(rows[kc], level, ks):
                    found[ks] = (kc, bool(level))
        return found

    def type_text(self, text):
        """Type literal text; returns {"remapped_characters": n, ...}."""
        keysyms = text_keysyms(text)
        if not keysyms:
            return {"remapped_characters": 0}
        active = blocking_state(self.modifier_mask())
        if active:
            raise CuError("keyboard_state", "cannot type reliably while %s is active" % ", ".join(active),
                          "release held modifiers, turn off Caps Lock (cu key Caps_Lock) "
                          "and switch to the first keyboard layout")
        shift_kc = self.keycode_levels(SHIFT_KEYSYM)[0]
        result = {"remapped_characters": 0}
        # Lock and recover first so the layout scan never sees stale scratch keys.
        with ScratchKeys(self) as scratch:
            direct = self.direct_keysyms(scratch.rows)
            if not shift_kc:
                direct = {ks: v for ks, v in direct.items() if not v[1]}
            batches = plan_typing(keysyms, direct, len(scratch.slots))  # preflight before any input
            for assign, steps in batches:
                if assign:
                    scratch.assign(assign)
                for step in steps:
                    if step[0] == "key":
                        self.tap([shift_kc, step[1]] if step[2] else [step[1]])
                    else:
                        self.tap([scratch.slots[step[1]]])
                        result["remapped_characters"] += 1
        if scratch.conflicts:
            result["keymap_conflicts"] = scratch.conflicts
        if scratch.restore_failed:
            result["keymap_restore_failed"] = True  # retried by the next type
        return result

    # --- pointer -----------------------------------------------------------

    def move(self, x, y):
        self.xtst.XTestFakeMotionEvent(self.dpy, self.screen, x, y, 0)
        self.sync()

    def button(self, number, count=1, interval=CLICK_INTERVAL):
        try:
            for i in range(count):
                self._buttons_held.append(number)  # track first so cleanup covers an interrupted press
                self.xtst.XTestFakeButtonEvent(self.dpy, number, 1, 0)
                self.x11.XFlush(self.dpy)
                time.sleep(0.01)
                self.xtst.XTestFakeButtonEvent(self.dpy, number, 0, 0)
                self._buttons_held.remove(number)
                self.x11.XFlush(self.dpy)
                if i + 1 < count:
                    time.sleep(interval)
        finally:
            self.release_all()
        self.sync()


# ---------------------------------------------------------------------------
# Window metadata (xprop) and screenshots (xwd)
# ---------------------------------------------------------------------------

def run_tool(argv, binary=False, timeout=20):
    try:
        proc = subprocess.run(argv, capture_output=True, timeout=timeout)
    except FileNotFoundError:
        raise CuError("tool_missing", "%s is not installed" % argv[0], "install the %s package" % argv[0])
    except subprocess.TimeoutExpired:
        raise CuError("tool_timeout", "%s timed out" % argv[0], display_hint())
    if proc.returncode != 0:
        msg = proc.stderr.decode("utf-8", "replace").strip() or "exit status %d" % proc.returncode
        raise CuError("tool_failed", "%s failed: %s" % (argv[0], msg), display_hint())
    return proc.stdout if binary else proc.stdout.decode("utf-8", "replace")


def parse_active_window(output):
    """Parse `xprop -root _NET_ACTIVE_WINDOW`; returns int window id or None.

    Handles both "window id # 0x1a00003" and "window id # 0x1a00003, 0x0".
    """
    m = re.search(r"window id # (0x[0-9a-fA-F]+)", output)
    if not m:
        return None
    wid = int(m.group(1), 16)
    return wid or None


_XPROP_STR = r'"((?:[^"\\]|\\.)*)"'


def _unescape(s):
    return re.sub(r"\\(.)", r"\1", s)


def parse_window_props(output):
    props = {}
    for line in output.splitlines():
        name, _, rest = line.partition("(")
        name = name.strip()
        if "=" not in line:
            continue
        value = line.split("=", 1)[1].strip()
        if name in ("_NET_WM_NAME", "WM_NAME"):
            m = re.match(_XPROP_STR, value)
            if m:
                props.setdefault("title", _unescape(m.group(1)))
        elif name == "WM_CLASS":
            parts = [_unescape(p) for p in re.findall(_XPROP_STR, value)]
            if parts:
                props["instance"] = parts[0]
                props["class"] = parts[-1]
        elif name == "_NET_WM_PID":
            m = re.match(r"(\d+)", value)
            if m:
                props["pid"] = int(m.group(1))
    return props


def active_window(xd=None):
    out = run_tool(["xprop", "-display", display_name(), "-root", "_NET_ACTIVE_WINDOW"])
    wid = parse_active_window(out)
    if wid is None:
        return None
    info = {"id": "0x%x" % wid}
    try:
        props = run_tool(["xprop", "-display", display_name(), "-id", "0x%x" % wid,
                          "_NET_WM_NAME", "WM_NAME", "WM_CLASS", "_NET_WM_PID"])
        info.update(parse_window_props(props))
    except CuError:
        info["error"] = "window properties unavailable"
    if xd is not None:
        geom = xd.window_geometry(wid)
        if geom:
            info["geometry"] = geom
    return info


def default_screenshot_path():
    try:
        fd, path = tempfile.mkstemp(prefix="cu-%s-" % time.strftime("%Y%m%d-%H%M%S"), suffix=".png")
    except OSError as exc:
        raise CuError("bad_path", "cannot create a screenshot file in the temp directory: %s"
                      % (exc.strerror or exc), "pass an explicit PNG path")
    os.close(fd)
    return path


def take_screenshot(path=None):
    path = os.path.abspath(os.path.expanduser(path or default_screenshot_path()))
    parent = os.path.dirname(path)
    if not os.path.isdir(parent):
        raise CuError("bad_path", "directory does not exist: %s" % parent)
    data = run_tool(["xwd", "-root", "-silent", "-display", display_name()], binary=True)
    width, height, rows = xwd_to_rgb(data)
    png = png_bytes(width, height, rows)
    tmp = "%s.tmp-%d" % (path, os.getpid())
    try:
        with open(tmp, "wb") as fh:
            fh.write(png)
        os.replace(tmp, path)
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise CuError("bad_path", "cannot write %s: %s" % (path, exc.strerror or exc))
    return {"path": path, "width": width, "height": height}


# ---------------------------------------------------------------------------
# Actions (shared by CLI and batch)
# ---------------------------------------------------------------------------

BUTTONS = {"left": 1, "middle": 2, "right": 3}
SCROLL_BUTTONS = {"up": 4, "down": 5, "left": 6, "right": 7}


def _is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def _is_number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _require(params, key, check, desc):
    if key not in params:
        raise usage_error("missing required field %r" % key)
    if not check(params[key]):
        raise usage_error("field %r must be %s" % (key, desc))
    return params[key]


def _optional(params, key, check, desc, default):
    if key not in params or params[key] is None:
        return default
    if not check(params[key]):
        raise usage_error("field %r must be %s" % (key, desc))
    return params[key]


def _nonempty_str(v):
    return isinstance(v, str) and v != ""


# Each spec: allowed fields and a validator that normalizes params.
def _v_none(p):
    return {}


def _v_path(p):
    return {"path": _optional(p, "path", _nonempty_str, "a non-empty string", None)}


def _v_open_tab(p):
    url = _require(p, "url", _nonempty_str, "a non-empty string")
    if any(c in url for c in "\r\n"):
        raise usage_error("url must not contain newlines")
    text_keysyms(url)
    return {"url": url}


def _v_key(p):
    keys = _require(p, "keys", _nonempty_str, "a non-empty string like 'ctrl+l'")
    parse_chord(keys)
    return {"keys": keys}


def _v_type(p):
    text = _require(p, "text", lambda v: isinstance(v, str), "a string")
    if text == "":
        raise usage_error("text must not be empty")
    if len(text) > MAX_TEXT_LENGTH:
        raise usage_error("text is longer than %d characters" % MAX_TEXT_LENGTH, "split it into several type actions")
    text_keysyms(text)  # reject untypeable characters before any input is sent
    return {"text": text}


def _v_point(p):
    return {"x": _require(p, "x", _is_int, "an integer pixel"),
            "y": _require(p, "y", _is_int, "an integer pixel")}


def _v_click(p):
    out = _v_point(p)
    out["button"] = _optional(p, "button", lambda v: isinstance(v, str) and v in BUTTONS, "one of left, middle, right", "left")
    out["count"] = _optional(p, "count", lambda v: _is_int(v) and 1 <= v <= MAX_CLICK_COUNT,
                             "an integer from 1 to %d" % MAX_CLICK_COUNT, 1)
    return out


def _v_scroll(p):
    direction = _require(p, "direction", lambda v: isinstance(v, str) and v in SCROLL_BUTTONS, "one of up, down, left, right")
    amount = _optional(p, "amount", lambda v: _is_int(v) and 1 <= v <= MAX_SCROLL_TICKS,
                       "an integer from 1 to %d ticks" % MAX_SCROLL_TICKS, 3)
    return {"direction": direction, "amount": amount}


def _v_wait(p):
    seconds = _require(p, "seconds", lambda v: _is_number(v) and v == v and 0 <= v <= MAX_WAIT_SECONDS,
                       "a number of seconds from 0 to %g" % MAX_WAIT_SECONDS)
    return {"seconds": float(seconds)}


VALIDATORS = {
    "info": (set(), _v_none),
    "observe": ({"path"}, _v_path),
    "screenshot": ({"path"}, _v_path),
    "open-tab": ({"url"}, _v_open_tab),
    "key": ({"keys"}, _v_key),
    "type": ({"text"}, _v_type),
    "click": ({"x", "y", "button", "count"}, _v_click),
    "move": ({"x", "y"}, _v_point),
    "scroll": ({"direction", "amount"}, _v_scroll),
    "wait": ({"seconds"}, _v_wait),
}

NEEDS_DISPLAY = {"info", "observe", "open-tab", "key", "type", "click", "move", "scroll"}


def validate_action(item):
    if not isinstance(item, dict):
        raise usage_error("each batch item must be a JSON object")
    action = item.get("action")
    if not isinstance(action, str) or action not in VALIDATORS:
        raise usage_error("unknown action %r" % (action,), "valid actions: " + ", ".join(sorted(VALIDATORS)))
    allowed, validator = VALIDATORS[action]
    unknown = sorted(set(item) - allowed - {"action"})
    if unknown:
        raise usage_error("unknown field(s) for %s: %s" % (action, ", ".join(unknown)))
    params = validator(item)
    params["action"] = action
    return params


class Session:
    """Lazily opens the display once for a command or batch."""

    def __init__(self):
        self._xd = None

    @property
    def xd(self):
        if self._xd is None:
            self._xd = XDisplay()
        return self._xd

    def close(self):
        if self._xd is not None:
            self._xd.close()
            self._xd = None

    def check_point(self, x, y):
        xd = self.xd
        if not (0 <= x < xd.width and 0 <= y < xd.height):
            raise CuError("out_of_bounds", "point (%d, %d) is outside the %dx%d display" % (x, y, xd.width, xd.height),
                          "coordinates are native screenshot pixels", exit_code=EXIT_USAGE)

    def info(self):
        xd = self.xd
        return {
            "display": {"name": display_name(), "width": xd.width, "height": xd.height},
            "pointer": xd.pointer(),
            "active_window": active_window(xd),
        }

    def run(self, p):
        action = p["action"]
        result = {"action": action}
        if action == "info":
            result.update(self.info())
        elif action == "observe":
            result.update(self.info())
            result["screenshot"] = take_screenshot(p.get("path"))
            result["next"] = "view the PNG at screenshot.path before acting"
        elif action == "screenshot":
            result["screenshot"] = take_screenshot(p.get("path"))
        elif action == "open-tab":
            xd = self.xd
            xd.press_chord("ctrl+t")
            time.sleep(OPEN_TAB_SETTLE)
            xd.type_text(p["url"])
            xd.press_chord("Return")
            result["url"] = p["url"]
            result["next"] = "run `cu wait 1` then observe; page load is not detected"
        elif action == "key":
            self.xd.press_chord(p["keys"])
            result["keys"] = p["keys"]
        elif action == "type":
            typed = self.xd.type_text(p["text"])
            result["characters"] = len(p["text"])
            result.update(typed)
        elif action == "click":
            self.check_point(p["x"], p["y"])
            self.xd.move(p["x"], p["y"])
            time.sleep(0.03)
            self.xd.button(BUTTONS[p["button"]], p["count"])
            result.update({"x": p["x"], "y": p["y"], "button": p["button"], "count": p["count"]})
        elif action == "move":
            self.check_point(p["x"], p["y"])
            self.xd.move(p["x"], p["y"])
            result.update({"x": p["x"], "y": p["y"]})
        elif action == "scroll":
            self.xd.button(SCROLL_BUTTONS[p["direction"]], p["amount"], SCROLL_INTERVAL)
            result.update({"direction": p["direction"], "amount": p["amount"], "pointer": self.xd.pointer()})
        elif action == "wait":
            time.sleep(p["seconds"])
            result["seconds"] = p["seconds"]
        return result


def run_batch(items, final_screenshot=None):
    if isinstance(items, dict) and isinstance(items.get("actions"), list):
        items = items["actions"]
    if not isinstance(items, list):
        raise usage_error("batch input must be a JSON array of action objects")
    if not items:
        raise usage_error("batch is empty")
    validated = []
    for i, item in enumerate(items):
        try:
            validated.append(validate_action(item))
        except CuError as exc:
            exc.extra["index"] = i
            raise
    session = Session()
    results = []
    try:
        for i, params in enumerate(validated):
            if params["action"] == "key":
                try:
                    session.xd.resolve_chord(params["keys"])
                except CuError as exc:
                    return {"ok": False, "completed": 0, "results": [], "failed_index": i,
                            "error": exc.to_json()}, exc.exit_code
        for i, params in enumerate(validated):
            try:
                results.append(session.run(params))
            except CuError as exc:
                return {"ok": False, "completed": len(results), "results": results,
                        "failed_index": i, "error": exc.to_json()}, exc.exit_code
        out = {"ok": True, "completed": len(results), "results": results}
        if final_screenshot:
            try:
                out["screenshot"] = take_screenshot(final_screenshot)
            except CuError as exc:
                out.update(ok=False, failed_index=len(validated), error=exc.to_json())
                return out, exc.exit_code
        return out, 0
    finally:
        session.close()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        raise usage_error(message, "run `%s --help`" % self.prog)


def build_parser():
    parser = JsonArgumentParser(
        prog="cu",
        description="Control the current X11 desktop: screenshots, clicks, keys, text. All output is JSON.",
        epilog=HELP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version="cu " + VERSION)
    sub = parser.add_subparsers(dest="command", metavar="COMMAND", parser_class=JsonArgumentParser)

    sub.add_parser("info", help="focused window title/class/pid/geometry, display size, pointer")
    p = sub.add_parser("observe", help="info plus a screenshot")
    p.add_argument("path", nargs="?", help="PNG path (default: a new file in the temp dir)")
    p = sub.add_parser("screenshot", help="capture the full desktop as PNG")
    p.add_argument("path", nargs="?", help="PNG path (default: a new file in the temp dir)")
    p = sub.add_parser("open-tab", help="Ctrl+T in the focused browser, type URL, Enter")
    p.add_argument("url")
    p = sub.add_parser("key", help="send a key chord such as ctrl+l, alt+Left, Return")
    p.add_argument("keys")
    p = sub.add_parser("type", help="type literal text (any Unicode; characters missing from the layout use a temporary keymap entry)")
    p.add_argument("text")
    p = sub.add_parser("click", help="click at desktop pixel X Y")
    p.add_argument("x", type=int)
    p.add_argument("y", type=int)
    p.add_argument("--button", choices=sorted(BUTTONS), default="left")
    p.add_argument("--count", type=int, default=1, help="1=single, 2=double, 3=triple")
    p = sub.add_parser("move", help="move the pointer to X Y")
    p.add_argument("x", type=int)
    p.add_argument("y", type=int)
    p = sub.add_parser("scroll", help="wheel ticks at the current pointer position")
    p.add_argument("direction", choices=sorted(SCROLL_BUTTONS))
    p.add_argument("amount", nargs="?", type=int, default=3)
    p = sub.add_parser("wait", help="sleep for SECONDS (max %g)" % MAX_WAIT_SECONDS)
    p.add_argument("seconds", type=float)
    p = sub.add_parser("batch", help="run a JSON action array from FILE or - (stdin)",
                       epilog=HELP_EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("file")
    p.add_argument("--screenshot", metavar="PATH", help="capture the final state after the batch")
    return parser


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def _interrupt(signum, _frame):
    raise KeyboardInterrupt


def main(argv=None):
    parser = build_parser()
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, _interrupt)  # run cleanup (key release, keymap restore)
        except (ValueError, OSError):
            pass
    try:
        args = parser.parse_args(argv)
        if not args.command:
            parser.print_help()
            return EXIT_USAGE
        if args.command == "batch":
            try:
                if args.file == "-":
                    raw = sys.stdin.read()
                else:
                    with open(args.file, encoding="utf-8") as fh:
                        raw = fh.read()
            except OSError as exc:
                raise usage_error("cannot read batch file: %s" % (exc.strerror or exc))
            try:
                items = json.loads(raw)
            except json.JSONDecodeError as exc:
                raise usage_error("batch input is not valid JSON: %s" % exc)
            out, code = run_batch(items, args.screenshot)
            emit(out)
            return code
        item = {k: v for k, v in vars(args).items() if k != "command" and v is not None}
        item["action"] = args.command
        params = validate_action(item)
        session = Session()
        try:
            result = session.run(params)
        finally:
            session.close()
        result["ok"] = True
        emit(dict([("ok", True)] + [(k, v) for k, v in result.items() if k != "ok"]))
        return 0
    except CuError as exc:
        emit({"ok": False, "error": exc.to_json()})
        return exc.exit_code
    except KeyboardInterrupt:
        emit({"ok": False, "error": {"code": "interrupted", "message": "interrupted"}})
        return 130


if __name__ == "__main__":
    sys.exit(main())
