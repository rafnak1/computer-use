for _n in range(1, 25):
    KEY_ALIASES["f%d" % _n] = "F%d" % _n

SHIFT_KEYSYM = 0xFFE1
CONTROL_KEYSYM = 0xFFE3
RETURN_KEYSYM = 0xFF0D
TAB_KEYSYM = 0xFF09


def char_keysym(ch):
    """Keysym for a single character (Latin-1 direct, else Unicode keysym)."""
    cp = ord(ch)
    if ch == "\n":
        return RETURN_KEYSYM
    if ch == "\t":
        return TAB_KEYSYM
    if 0x20 <= cp <= 0x7E or 0xA0 <= cp <= 0xFF:
        return cp
    return 0x01000000 | cp


NO_SYMBOL = 0
# Core modifier-state bits that would change what a typed key produces.
BLOCKING_STATE = (("Shift", 0x01), ("Caps Lock", 0x02), ("Control", 0x04),
                  ("Alt (Mod1)", 0x08), ("Super (Mod4)", 0x40))
XKB_GROUP_MASK = 0x6000


def text_keysyms(text):
    """Keysyms for literal text; rejects characters no key can produce."""
    out = []
    for i, ch in enumerate(text):
        cp = ord(ch)
        if ch == "\r":
            continue
        if (cp < 0x20 and ch not in "\n\t") or 0x7F <= cp <= 0x9F:
            raise usage_error("text contains control character U+%04X at index %d" % (cp, i))
        if 0xD800 <= cp <= 0xDFFF:
            raise usage_error("text contains an unpaired surrogate U+%04X at index %d" % (cp, i),
                              "pass valid UTF-8 text")
        out.append(char_keysym(ch))
    return out


def blocking_state(mask):
    """Names of active modifiers/groups that would garble typed text."""
    names = [name for name, bit in BLOCKING_STATE if mask & bit]
    if mask & XKB_GROUP_MASK:
        names.append("keyboard group %d" % (((mask & XKB_GROUP_MASK) >> 13) + 1))
    return names


def strip_row(row):
    """Keysym row without trailing NoSymbol padding."""
    row = list(row)
    while row and row[-1] == NO_SYMBOL:
        row.pop()
    return tuple(row)


def row_signature(row):
    """The set of keysyms in a row."""
    return frozenset(ks for ks in row if ks != NO_SYMBOL)


def scratch_row_matches(current, recorded):
    """Whether keycode row `current` is the one we recorded.

    Rows are compared exactly (ignoring trailing NoSymbol). The server (XKB)
    rewrites core rows we install, e.g. [e, e] reads back as [e, NoSymbol, e];
    for a recorded install row [ks, ks] we also accept any row that starts
    with ks and holds nothing but ks, which covers a crash before the
    server's actual row was read back and journaled.
    """
    cur, rec = strip_row(current), strip_row(recorded)
    if cur == rec:
        return True
    return (len(rec) == 2 and rec[0] == rec[1] and bool(cur) and cur[0] == rec[0]
            and row_signature(cur) == {rec[0]})


def core_level_matches(row, level, keysym):
    """Whether a core keymap row has keysym at group 1, `level` (0 or 1)."""
    return len(row) > level and row[level] == keysym


def find_scratch_keycodes(rows, exclude=()):
    """Keycodes with no keysyms at all, highest first, minus excluded ones."""
    return sorted((kc for kc, row in rows.items()
                   if kc >= 8 and kc not in exclude and not strip_row(row)), reverse=True)


def plan_typing(keysyms, direct, capacity):
    """Split keysyms into batches of (scratch assignment, steps).

    direct maps keysym -> (keycode, needs_shift) for keys on the layout. Other
    keysyms get a scratch slot; a batch never needs more than `capacity`
    slots. Steps are ("key", keycode, needs_shift) or ("scratch", slot).
    """
    batches, assign, steps = [], [], []
    for ks in keysyms:
        if ks in direct:
            kc, shift = direct[ks]
            steps.append(("key", kc, shift))
            continue
        if ks not in assign:
            if capacity <= 0:
                raise CuError("no_scratch_keycode",
                              "no unused keycode is free to type characters missing from the keyboard layout",
                              "free a keycode (e.g. remove an unused binding with xmodmap) or type only "
                              "characters on the current layout")
            if len(assign) == capacity:
                batches.append((assign, steps))
                assign, steps = [], []
            assign.append(ks)
        steps.append(("scratch", assign.index(ks)))
    if steps:
        batches.append((assign, steps))
    return batches


def keymap_state_paths():
    """(lock path, journal path) for this user and display."""
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    tag = re.sub(r"[^A-Za-z0-9.]+", "_", display_name())
    stem = os.path.join(base, "cu-keymap-%d-%s" % (os.getuid(), tag))
    return stem + ".lock", stem + ".json"


def _check_private_file(fd, path, code="keymap_lock"):
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        raise CuError(code, "refusing to use %s: not a private regular file owned by you" % path,
                      "remove it or set XDG_RUNTIME_DIR to a private directory")


def open_lock_file(path, code):
    """Open (creating if needed) a private lock file without following symlinks."""
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0), 0o600)
    except OSError as exc:
        raise CuError(code, "cannot open lock file %s: %s" % (path, exc.strerror or exc),
                      "set XDG_RUNTIME_DIR to a private, writable directory")
    try:
        _check_private_file(fd, path, code)
    except BaseException:
        os.close(fd)
        raise
    return fd


def acquire_flock(fd, timeout):
    """Take an exclusive flock on fd; False if it is still held after timeout seconds."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError as exc:
            if exc.errno not in (errno.EAGAIN, errno.EACCES):
                raise
        left = deadline - time.monotonic()
        if left <= 0:
            return False
        time.sleep(min(0.05, left))


def input_lock_path():
    """Lock file for this user and display; every screen of a display shares it."""
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    display = re.sub(r"(:\d+)\.\d+$", r"\1", display_name())
    tag = re.sub(r"[^A-Za-z0-9.]+", "_", display)
    return os.path.join(base, "cu-input-%d-%s.lock" % (os.getuid(), tag))


class InputLock:
    """Serialises cu processes that send input to this display.

    A command holds it from before its wait baseline until it ends, a batch
    for its whole run. It is always taken before the keymap lock. The file
    holds the holder's PID for error messages only; the flock is what counts
    and the kernel drops it when the holder dies.
    """

    def __init__(self):
        self.fd = None

    def acquire(self):
        try:
            path = input_lock_path()
        except OSError as exc:
            raise CuError("input_lock", "no directory for the input lock: %s" % (exc.strerror or exc),
                          "set XDG_RUNTIME_DIR to a private, writable directory")
        self.fd = open_lock_file(path, "input_lock")
        try:
            try:
                locked = acquire_flock(self.fd, INPUT_LOCK_TIMEOUT)
            except OSError as exc:
                raise CuError("input_lock", "cannot lock %s: %s" % (path, exc.strerror or exc))
            if not locked:
                pid = self._holder()
                raise CuError("busy", "another cu process%s is sending input to this display; nothing was sent"
                              % (" (PID %d)" % pid if pid else ""),
                              "wait for it to finish (or stop it) and retry; use `cu batch` for multi-step sequences",
                              holder_pid=pid)
            self._write(b"%d\n" % os.getpid())
        except BaseException:
            self.release()
            raise

    def release(self):
        if self.fd is not None:
            fd, self.fd = self.fd, None
            os.close(fd)  # releases the flock

    def __enter__(self):
        self.acquire()
        return self

    def __exit__(self, *exc):
        self.release()
        return False

    def _write(self, data):
        try:
            os.ftruncate(self.fd, 0)
            os.pwrite(self.fd, data, 0)
        except OSError:
            pass  # informative only

    def _holder(self):
        """The PID in the lock file, or None; it may be stale."""
        try:
            return int(os.pread(self.fd, 32, 0)) or None
        except (OSError, ValueError):
            return None


class ScratchKeys:
    """Temporarily bind keysyms to unused keycodes, restoring them afterwards.

    A display-scoped lock serialises keymap changes (input itself is already
    serialised by InputLock, which is taken first). A journal next to it records, before every change, each row a keycode may hold, so a run
    killed mid-typing is cleaned up by the next one. Only keycodes whose
    current row is one we installed are reset; anything else is reported.
    """

    def __init__(self, xd):
        self.xd = xd
        self.fd = None
        self.slots = []
        self.rows = {}
        self.installed = {}  # keycode -> [rows it may hold because of us]
        self.conflicts = []
        self.restore_failed = False

    def __enter__(self):
        self._lock()
        try:
            self._recover()
            kmin, kmax, width, self.rows = self.xd.keyboard_mapping()
            self.width = max(width, 2)
            exclude = self.xd.modifier_keycodes() | self.xd.pressed_keycodes()
            self.slots = find_scratch_keycodes(self.rows, exclude)
        except BaseException:
            self._unlock()
            raise
        return self

    def __exit__(self, *exc):
        try:
            self.restore()
        finally:
            self._unlock()
        return False

    # --- lock and journal -----------------------------------------------

    def _lock(self):
        path, self.journal = keymap_state_paths()
        self.fd = open_lock_file(path, "keymap_lock")
        try:
            try:
                locked = acquire_flock(self.fd, KEYMAP_LOCK_TIMEOUT)
            except OSError as exc:
                raise CuError("keymap_lock", "cannot lock %s: %s" % (path, exc.strerror or exc))
            if not locked:
                raise CuError("keymap_busy", "another cu process is typing on this display",
                              "retry when it finishes")
        except BaseException:
            self._unlock()
            raise

    def _unlock(self):
        if self.fd is not None:
            os.close(self.fd)  # releases the flock
            self.fd = None

    def _save(self):
        """Atomically replace the journal with the current candidate rows."""
        data = json.dumps({"pid": os.getpid(),
                           "keys": {str(k): [list(r) for r in v] for k, v in self.installed.items()}})
        fd, tmp = tempfile.mkstemp(prefix=".cu-keymap-", dir=os.path.dirname(self.journal))
        try:
            with os.fdopen(fd, "w") as fh:
                fh.write(data)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, self.journal)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise

    def _recover(self):
        try:
            fd = os.open(self.journal, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0))
        except FileNotFoundError:
            return
        except OSError as exc:
            raise CuError("keymap_lock", "cannot open keymap journal %s: %s" % (self.journal, exc.strerror or exc))
        try:
            _check_private_file(fd, self.journal)
            with os.fdopen(fd, "rb", closefd=False) as fh:
                raw = fh.read()
        finally:
            os.close(fd)
        try:
            keys = json.loads(raw.decode()).get("keys", {})
            self.installed = {int(k): [tuple(int(x) for x in r) for r in v] for k, v in keys.items()}
        except (ValueError, AttributeError, TypeError):
            self.installed = {}
        self.restore(settle=False)

    # --- mapping changes ------------------------------------------------

    def _ours(self, kc, current):
        """Whether keycode kc currently holds nothing or a row we installed."""
        return (not row_signature(current)
                or any(scratch_row_matches(current, r) for r in self.installed.get(kc, ())))

    def assign(self, keysyms):
        """Bind keysyms[i] to self.slots[i]; settles before and after."""
        if self.installed:
            time.sleep(KEYMAP_SETTLE)  # let clients translate keys already sent
        changes = []
        for i, ks in enumerate(keysyms):
            kc = self.slots[i]
            row = tuple([ks, ks] + [NO_SYMBOL] * (self.width - 2))
            current = self.xd.keycode_row(kc)
            if not self._ours(kc, current):
                self.installed.pop(kc, None)
                self.conflicts.append(kc)
                raise CuError("keymap_conflict",
                              "keycode %d was changed by another program while typing" % kc,
                              "part of the text may have been typed; check and retry", keymap_conflicts=[kc])
            if not scratch_row_matches(current, row):
                changes.append((kc, row))
        if not changes:
            return
        for kc, row in changes:  # journal old and new rows before mutating
            self.installed.setdefault(kc, [])
            if row not in self.installed[kc]:
                self.installed[kc].append(row)
        self._save()
        before = len(self.xd._errors)
        for kc, row in changes:
            self.xd.set_keycode_row(kc, row)
        self.xd.sync()
        if len(self.xd._errors) != before:  # keep every candidate row for cleanup
            raise CuError("keymap_change_failed", "the X server rejected a keyboard mapping change")
        for kc, row in changes:
            actual = self.xd.keycode_row(kc)  # the server's rewritten form of our row
            if not scratch_row_matches(actual, row):
                if kc not in self.conflicts:
                    self.conflicts.append(kc)
                raise CuError("keymap_conflict",
                              "keycode %d was changed by another program while typing" % kc,
                              "part of the text may have been typed; check and retry", keymap_conflicts=[kc])
            self.installed[kc] = [row] if strip_row(actual) == strip_row(row) else [row, tuple(actual)]
        self._save()
        time.sleep(KEYMAP_SETTLE)

    def restore(self, settle=True):
        if not self.installed:
            return
        if settle:
            time.sleep(KEYMAP_SETTLE)
        before = len(self.xd._errors)
        for kc, rows in sorted(self.installed.items()):
            current = self.xd.keycode_row(kc)
            if not row_signature(current):
                continue
            if self._ours(kc, current):
                self.xd.set_keycode_row(kc, (NO_SYMBOL,) * max(len(current), 2))
            elif kc not in self.conflicts:
                self.conflicts.append(kc)  # someone else changed it; leave theirs alone
        self.xd.sync()
        if len(self.xd._errors) != before:
            self.restore_failed = True  # keep the journal so the next run retries
            return
        self.installed = {}
        self._save()


def parse_chord(spec):
    """Split a chord into (modifier keysym names, key token).

    Returns a list of tokens; validation of names happens in resolve_token.
    "ctrl++" means ctrl and the plus key.
    """
    if not isinstance(spec, str) or not spec.strip():
        raise usage_error("key chord must be a non-empty string", "example: ctrl+l")
    spec = spec.strip()
    if spec == "+":
        return ["+"]
    if spec.endswith("++"):
        parts = spec[:-2].split("+") + ["+"]
    else:
        parts = spec.split("+")
    if any(p.strip() == "" for p in parts):
        raise usage_error("malformed key chord %r" % spec, "join key names with '+', e.g. ctrl+shift+Tab")
    return [p.strip() for p in parts]


# ---------------------------------------------------------------------------
# PNG / XWD
# ---------------------------------------------------------------------------

def png_bytes(width, height, rgb_rows):
    """Encode an RGB image (iterable of row bytes) as PNG."""
    def chunk(kind, data):
        body = kind + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xFFFFFFFF)

    raw = bytearray()
    for row in rgb_rows:
        raw.append(0)
        raw += row
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr)
            + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b""))


def _mask_shift(mask):
    if mask == 0:
        return 0, 0
    shift = (mask & -mask).bit_length() - 1
    width = (mask >> shift).bit_length()
    return shift, width


def _xwd_header(data):
    """Validated XWD (version 7, ZPixmap) header fields plus pixel offsets."""
    if len(data) < 100:
        raise CuError("screenshot_failed", "xwd output is truncated")
    fields = struct.unpack(">25I", data[:100])
    (header_size, version, fmt, depth, width, height, _xoff, byte_order,
     _bunit, _bbo, _bpad, bpp, bpl, vclass, rmask, gmask, bmask, _bits_rgb,
     _cmap_entries, ncolors) = fields[:20]
    if version != 7:
        raise CuError("screenshot_failed", "unsupported XWD version %d" % version)
    if fmt != 2:
        raise CuError("screenshot_failed", "unsupported XWD pixmap format %d (expected ZPixmap)" % fmt)
    if width == 0 or height == 0 or width > 65535 or height > 65535:
        raise CuError("screenshot_failed", "invalid XWD dimensions %dx%d" % (width, height))
    if bpp not in (8, 16, 24, 32) or bpl < (width * bpp + 7) // 8:
        raise CuError("screenshot_failed", "unsupported XWD layout (bpp=%d, bytes_per_line=%d)" % (bpp, bpl))
    cmap_off = header_size
    pix_off = cmap_off + ncolors * 12
    need = pix_off + bpl * height
    if len(data) < need:
        raise CuError("screenshot_failed", "xwd output is truncated (%d < %d bytes)" % (len(data), need))
    return (width, height, byte_order, bpp, bpl, vclass, rmask, gmask, bmask,
            cmap_off, ncolors, pix_off, need)


def xwd_frame(data):
    """Raw pixels of an XWD image for comparison: {"layout": (w, h, bytes/pixel, bytes/line), "pixels"}."""
    width, height, _bo, bpp, bpl, *_rest, cmap_off, _ncolors, pix_off, need = _xwd_header(data)
    # The colormap matters on indexed-colour displays, where palette animation keeps pixel values.
    return {"layout": (width, height, bpp // 8, bpl), "colormap": bytes(data[cmap_off:pix_off]),
            "pixels": bytes(data[pix_off:need])}


def changed_pixels(a, b, limit):
    """Pixels that differ between frames a and b, counting stops once above limit."""
    if a["layout"] != b["layout"] or a.get("colormap") != b.get("colormap"):
        return float("inf")
    pa, pb = a["pixels"], b["pixels"]
    if pa == pb:
        return 0
    width, height, bypp, bpl = a["layout"]
    row_len = width * bypp
    count = 0
    for y in range(height):
        o = y * bpl
        ra, rb = pa[o:o + row_len], pb[o:o + row_len]
        if ra == rb:
            continue
        if bypp == 4:
            count += sum(1 for p, q in zip(memoryview(ra).cast("I"), memoryview(rb).cast("I")) if p != q)
        else:
            count += sum(1 for x in range(0, row_len, bypp) if ra[x:x + bypp] != rb[x:x + bypp])
        if count > limit:
            break
    return count


def xwd_to_rgb(data):
    """Parse an XWD (X Window Dump, version 7) ZPixmap image.

    Returns (width, height, list_of_rgb_row_bytes).
    """
    (width, height, byte_order, bpp, bpl, vclass, rmask, gmask, bmask,
     cmap_off, ncolors, pix_off, need) = _xwd_header(data)
    colormap = {}
    for i in range(ncolors):
        pixel, r, g, b = struct.unpack(">IHHH", data[cmap_off + i * 12: cmap_off + i * 12 + 10])
        colormap[pixel] = (r >> 8, g >> 8, b >> 8)

    bypp = bpp // 8
    pix = memoryview(data)[pix_off:need]
    rows = []
    truecolor = vclass in (4, 5) and rmask and gmask and bmask  # TrueColor / DirectColor

    # Fast path: 24/32 bpp with byte-aligned 8-bit channels.
    if truecolor and bypp in (3, 4):
        offsets = []
        for mask in (rmask, gmask, bmask):
            shift, w = _mask_shift(mask)
            if w != 8 or shift % 8:
                offsets = None
                break
            idx = shift // 8
            offsets.append(idx if byte_order == 0 else bypp - 1 - idx)
        if offsets:
            ro, go, bo = offsets
            row_len = width * bypp
            for y in range(height):
                src = pix[y * bpl: y * bpl + row_len]
                out = bytearray(width * 3)
                out[0::3] = src[ro::bypp]
                out[1::3] = src[go::bypp]
                out[2::3] = src[bo::bypp]
                rows.append(bytes(out))
            return width, height, rows

    # Generic path (slow but complete).
    endian = "little" if byte_order == 0 else "big"
    if truecolor:
        chans = [_mask_shift(m) for m in (rmask, gmask, bmask)]
    for y in range(height):
        base = y * bpl
        out = bytearray(width * 3)
        for x in range(width):
            o = base + x * bypp
            value = int.from_bytes(pix[o:o + bypp], endian)
            if truecolor:
                rgb = []
                for (shift, w) in chans:
                    v = (value >> shift) & ((1 << w) - 1)
                    rgb.append((v * 255) // ((1 << w) - 1) if w else 0)
            else:
                rgb = colormap.get(value, (0, 0, 0))
            out[x * 3: x * 3 + 3] = bytes(rgb)
        rows.append(bytes(out))
    return width, height, rows


# ---------------------------------------------------------------------------
# X11 access
# ---------------------------------------------------------------------------

def display_name():
    return os.environ.get("DISPLAY") or ":0"


def display_hint():
    return ("Check that an unlocked X11 session is running on DISPLAY=%s and that "
            "XAUTHORITY grants access. Sandboxed agents must run desktop commands "
            "with escalated/unsandboxed permissions." % display_name())


_X_ERROR_HANDLER_TYPE = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)


class _XModifierKeymap(ctypes.Structure):
    _fields_ = [("max_keypermod", ctypes.c_int), ("modifiermap", ctypes.POINTER(ctypes.c_ubyte))]


class XDisplay:
    """Thin ctypes wrapper over libX11 + libXtst."""

    def __init__(self):
        self.x11 = self._load("X11", "libX11.so.6")
        self.xtst = self._load("Xtst", "libXtst.so.6")
        self._declare()
        self._errors = []
        self._held = []
        self._buttons_held = []
        self.dpy = None

        def _handler(_dpy, _event):
            self._errors.append(True)
            return 0

        self._handler = _X_ERROR_HANDLER_TYPE(_handler)  # keep a reference
        self.x11.XSetErrorHandler(self._handler)
        name = display_name()
        self.dpy = self.x11.XOpenDisplay(name.encode())
        if not self.dpy:
            raise CuError("display_unavailable", "cannot open X display %s" % name, display_hint())
        ev = ctypes.c_int()
        err = ctypes.c_int()
        maj = ctypes.c_int()
        mnr = ctypes.c_int()
        if not self.xtst.XTestQueryExtension(self.dpy, ctypes.byref(ev), ctypes.byref(err),
                                             ctypes.byref(maj), ctypes.byref(mnr)):
            self.close()
            raise CuError("xtest_unavailable", "the X server lacks the XTEST extension")
        self.screen = self.x11.XDefaultScreen(self.dpy)
        self.root = self.x11.XRootWindow(self.dpy, self.screen)
        self.width = self.x11.XDisplayWidth(self.dpy, self.screen)
        self.height = self.x11.XDisplayHeight(self.dpy, self.screen)

    @staticmethod
    def _load(short, soname):
        path = ctypes.util.find_library(short) or soname
        try:
            return ctypes.CDLL(path)
        except OSError as exc:
            raise CuError("library_missing", "cannot load %s (%s)" % (soname, exc),
                          "install the lib%s runtime library" % short)

    def _declare(self):
        x, t = self.x11, self.xtst
        vp, ul, ci, cu, cb = ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_uint, ctypes.c_ubyte
        P = ctypes.POINTER
        x.XSetErrorHandler.argtypes = [_X_ERROR_HANDLER_TYPE]
        x.XSetErrorHandler.restype = vp
        x.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x.XOpenDisplay.restype = vp
        x.XCloseDisplay.argtypes = [vp]
        x.XDefaultScreen.argtypes = [vp]
        x.XDefaultScreen.restype = ci
        x.XRootWindow.argtypes = [vp, ci]
        x.XRootWindow.restype = ul
        x.XDisplayWidth.argtypes = [vp, ci]
        x.XDisplayWidth.restype = ci
        x.XDisplayHeight.argtypes = [vp, ci]
        x.XDisplayHeight.restype = ci
        x.XFlush.argtypes = [vp]
        x.XSync.argtypes = [vp, ci]
        x.XStringToKeysym.argtypes = [ctypes.c_char_p]
        x.XStringToKeysym.restype = ul
        x.XKeysymToKeycode.argtypes = [vp, ul]
        x.XKeysymToKeycode.restype = cb
        x.XkbKeycodeToKeysym.argtypes = [vp, cb, ci, ci]
        x.XkbKeycodeToKeysym.restype = ul
        x.XDisplayKeycodes.argtypes = [vp, P(ci), P(ci)]
        x.XGetKeyboardMapping.argtypes = [vp, cu, ci, P(ci)]
        x.XGetKeyboardMapping.restype = P(ul)
        x.XChangeKeyboardMapping.argtypes = [vp, ci, ci, P(ul), ci]
        x.XGetModifierMapping.argtypes = [vp]
        x.XGetModifierMapping.restype = P(_XModifierKeymap)
        x.XFreeModifiermap.argtypes = [P(_XModifierKeymap)]
        x.XQueryKeymap.argtypes = [vp, ctypes.c_char * 32]
        x.XFree.argtypes = [vp]
        x.XQueryPointer.argtypes = [vp, ul, P(ul), P(ul), P(ci), P(ci), P(ci), P(ci), P(cu)]
        x.XQueryPointer.restype = ci
        x.XGetGeometry.argtypes = [vp, ul, P(ul), P(ci), P(ci), P(cu), P(cu), P(cu), P(cu)]
        x.XGetGeometry.restype = ci
        x.XTranslateCoordinates.argtypes = [vp, ul, ul, ci, ci, P(ci), P(ci), P(ul)]
        x.XTranslateCoordinates.restype = ci
        x.XInternAtom.argtypes = [vp, ctypes.c_char_p, ci]
        x.XInternAtom.restype = ul
        x.XGetAtomName.argtypes = [vp, ul]
        x.XGetAtomName.restype = vp
        x.XGetSelectionOwner.argtypes = [vp, ul]
        x.XGetSelectionOwner.restype = ul
        x.XConvertSelection.argtypes = [vp, ul, ul, ul, ul, ul]
        x.XCreateSimpleWindow.argtypes = [vp, ul, ci, ci, cu, cu, cu, ul, ul]
        x.XCreateSimpleWindow.restype = ul
        x.XDestroyWindow.argtypes = [vp, ul]
        x.XSelectInput.argtypes = [vp, ul, ctypes.c_long]
        x.XConnectionNumber.argtypes = [vp]
        x.XConnectionNumber.restype = ci
        x.XPending.argtypes = [vp]
        x.XPending.restype = ci
        x.XNextEvent.argtypes = [vp, vp]
        x.XGetWindowProperty.argtypes = [vp, ul, ul, ctypes.c_long, ctypes.c_long, ci, ul, P(ul), P(ci),
                                         P(ul), P(ul), P(P(cb))]
        x.XGetWindowProperty.restype = ci
        x.XDeleteProperty.argtypes = [vp, ul, ul]
        t.XTestQueryExtension.argtypes = [vp, P(ci), P(ci), P(ci), P(ci)]
        t.XTestQueryExtension.restype = ci
        t.XTestFakeKeyEvent.argtypes = [vp, cu, ci, ul]
        t.XTestFakeButtonEvent.argtypes = [vp, cu, ci, ul]
        t.XTestFakeMotionEvent.argtypes = [vp, ci, ci, ci, ul]

    def close(self):
        if getattr(self, "dpy", None):
            self.release_all()
            self.x11.XCloseDisplay(self.dpy)
            self.dpy = None

    def sync(self):
        self.x11.XSync(self.dpy, 0)

    # --- queries ---------------------------------------------------------

    def pointer(self):
        root, child = ctypes.c_ulong(), ctypes.c_ulong()
        rx, ry, wx, wy = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
        mask = ctypes.c_uint()
        self.x11.XQueryPointer(self.dpy, self.root, ctypes.byref(root), ctypes.byref(child),
                               ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx),
                               ctypes.byref(wy), ctypes.byref(mask))
        return {"x": rx.value, "y": ry.value}

    def window_geometry(self, wid):
        root = ctypes.c_ulong()
        x, y = ctypes.c_int(), ctypes.c_int()
        w, h, bw, depth = ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint(), ctypes.c_uint()
        before = len(self._errors)
        ok = self.x11.XGetGeometry(self.dpy, wid, ctypes.byref(root), ctypes.byref(x), ctypes.byref(y),
                                   ctypes.byref(w), ctypes.byref(h), ctypes.byref(bw), ctypes.byref(depth))
        self.sync()
        if not ok or len(self._errors) != before:
            return None
        ax, ay, child = ctypes.c_int(), ctypes.c_int(), ctypes.c_ulong()
        self.x11.XTranslateCoordinates(self.dpy, wid, self.root, 0, 0, ctypes.byref(ax),
                                       ctypes.byref(ay), ctypes.byref(child))
        self.sync()
        if len(self._errors) != before:
            return None
        return {"x": ax.value, "y": ay.value, "width": w.value, "height": h.value}

    # --- keyboard ----------------------------------------------------------

    def keysym_for_token(self, token):
        """Resolve a chord token to (keysym, is_modifier) or raise."""
        low = token.lower()
        if low in MODIFIERS:
            name = MODIFIERS[low]
            return self.x11.XStringToKeysym(name.encode()), True
        name = KEY_ALIASES.get(low, token)
        ks = 0
        if len(name) == 1:
            ks = char_keysym(name)
        else:
            ks = self.x11.XStringToKeysym(name.encode())
            if not ks:
                # case-insensitive retry for names like "pagedown" -> already aliased; try capitalized
                ks = self.x11.XStringToKeysym(name.capitalize().encode())
        if not ks:
            raise usage_error("unknown key name %r" % token,
                              "use X keysym names such as Return, Escape, Tab, Left, F5, a, ctrl, shift, alt, super")
        return ks, False

    def keycode_levels(self, keysym):
        """Return (keycode, needs_shift) for keysym, or (0, False) when not mapped."""
        kc = self.x11.XKeysymToKeycode(self.dpy, keysym)
        if not kc:
            return 0, False
        if self.x11.XkbKeycodeToKeysym(self.dpy, kc, 0, 0) == keysym:
            return kc, False
        if self.x11.XkbKeycodeToKeysym(self.dpy, kc, 0, 1) == keysym:
            return kc, True
        # Keysym lives on another group/level; letters still map sensibly.
        return kc, False

    def _key(self, keycode, press):
        if press:
            self._held.append(keycode)  # track first so cleanup covers an interrupted press
        self.xtst.XTestFakeKeyEvent(self.dpy, keycode, 1 if press else 0, 0)
        if not press and keycode in self._held:
            self._held.remove(keycode)

    def release_all(self):
        if not self.dpy:
            return
        for kc in reversed(list(self._held)):
            self.xtst.XTestFakeKeyEvent(self.dpy, kc, 0, 0)
        self._held = []
        for number in reversed(list(self._buttons_held)):
            self.xtst.XTestFakeButtonEvent(self.dpy, number, 0, 0)
        self._buttons_held = []
        self.x11.XFlush(self.dpy)

    def tap(self, keycodes):
        """Press keycodes in order, release in reverse."""
        try:
            for kc in keycodes:
                self._key(kc, True)
                self.x11.XFlush(self.dpy)
                time.sleep(KEY_DELAY)
            for kc in reversed(keycodes):
                self._key(kc, False)
                self.x11.XFlush(self.dpy)
                time.sleep(KEY_DELAY)
        finally:
            self.release_all()

    def resolve_chord(self, spec):
        tokens = parse_chord(spec)
        resolved = [(tok,) + self.keysym_for_token(tok) for tok in tokens]  # validate names first
        mods = [r for r in resolved if r[2]]
        keys = [r for r in resolved if not r[2]]
        if len(keys) > 1:
            raise usage_error("chord %r has more than one non-modifier key" % spec,
                              "send separate `key` commands for a sequence")
        codes = []
        has_shift = any(r[1] == SHIFT_KEYSYM for r in mods)
        for tok, ks, _ in mods:
            kc, _ = self.keycode_levels(ks)
            if not kc:
                raise CuError("key_unmapped", "modifier %r has no keycode in the current layout" % tok)
            if kc not in codes:
                codes.append(kc)
        for tok, ks, _ in keys:
            kc, needs_shift = self.keycode_levels(ks)
            if not kc:
                raise CuError("key_unmapped", "key %r has no keycode in the current keyboard layout" % tok,
                              "for literal characters use `cu type`")
            is_letter = len(tok) == 1 and tok.isalpha()
            if needs_shift and not has_shift and not is_letter:
                codes.append(self.keycode_levels(SHIFT_KEYSYM)[0])
            codes.append(kc)
        return codes

    def press_chord(self, spec):
        self.tap(self.resolve_chord(spec))

    def keycode_range(self):
        kmin, kmax = ctypes.c_int(), ctypes.c_int()
        self.x11.XDisplayKeycodes(self.dpy, ctypes.byref(kmin), ctypes.byref(kmax))
        return kmin.value, kmax.value

    def keyboard_mapping(self, first=None, count=None):
        """(min, max, keysyms_per_keycode, {keycode: row}) from the core keymap."""
        kmin, kmax = self.keycode_range()
        first = kmin if first is None else first
        count = kmax - first + 1 if count is None else count
        width = ctypes.c_int()
        ptr = self.x11.XGetKeyboardMapping(self.dpy, first, count, ctypes.byref(width))
        if not ptr:
            raise CuError("keymap_unavailable", "cannot read the keyboard mapping")
        try:
            w = width.value
            rows = {first + i: tuple(ptr[i * w + j] for j in range(w)) for i in range(count)}
        finally:
            self.x11.XFree(ptr)
        return kmin, kmax, w, rows

    def keycode_row(self, kc):
        return self.keyboard_mapping(kc, 1)[3][kc]

    def set_keycode_row(self, kc, row):
        arr = (ctypes.c_ulong * len(row))(*row)
        self.x11.XChangeKeyboardMapping(self.dpy, kc, len(row), arr, 1)

    def modifier_keycodes(self):
        mm = self.x11.XGetModifierMapping(self.dpy)
        if not mm:
            return set()
        try:
            n = mm.contents.max_keypermod * 8
            return {mm.contents.modifiermap[i] for i in range(n)} - {0}
        finally:
            self.x11.XFreeModifiermap(mm)

    def pressed_keycodes(self):
        buf = (ctypes.c_char * 32)()
        self.x11.XQueryKeymap(self.dpy, buf)
        return {i * 8 + b for i, byte in enumerate(buf.raw) for b in range(8) if byte & (1 << b)}

    def modifier_mask(self):
        root, child = ctypes.c_ulong(), ctypes.c_ulong()
        rx, ry, wx, wy = ctypes.c_int(), ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
        mask = ctypes.c_uint()
        self.x11.XQueryPointer(self.dpy, self.root, ctypes.byref(root), ctypes.byref(child),
                               ctypes.byref(rx), ctypes.byref(ry), ctypes.byref(wx),
                               ctypes.byref(wy), ctypes.byref(mask))
        return mask.value

    def direct_keysyms(self, rows):
        """keysym -> (keycode, needs_shift) for group 1, levels 1-2.

        Uses the XKB view, but only keeps keys whose freshly read core row
        (`rows`, columns 0-1 = group 1 levels 1-2) agrees at the same level:
        Xlib's cached XKB map can lag behind a recent mapping change.
        """
        found = {}
        for level in (0, 1):
            for kc in sorted(rows):
                ks = self.x11.XkbKeycodeToKeysym(self.dpy, kc, 0, level)
                if ks and ks not in found and core_level_matches(rows[kc], level, ks):
                    found[ks] = (kc, bool(level))
        return found

    def type_text(self, text):
        """Type literal text; returns {"remapped_characters": n, ...}."""
        keysyms = text_keysyms(text)
        if not keysyms:
            return {"remapped_characters": 0}
        active = blocking_state(self.modifier_mask())
        if active:
            raise CuError("keyboard_state", "cannot type reliably while %s is active" % ", ".join(active),
                          "release held modifiers, turn off Caps Lock (cu key Caps_Lock) "
                          "and switch to the first keyboard layout")
        shift_kc = self.keycode_levels(SHIFT_KEYSYM)[0]
        result = {"remapped_characters": 0}
        # Lock and recover first so the layout scan never sees stale scratch keys.
        with ScratchKeys(self) as scratch:
            direct = self.direct_keysyms(scratch.rows)
            if not shift_kc:
                direct = {ks: v for ks, v in direct.items() if not v[1]}
            batches = plan_typing(keysyms, direct, len(scratch.slots))  # preflight before any input
            for assign, steps in batches:
                if assign:
                    scratch.assign(assign)
                for step in steps:
                    if step[0] == "key":
                        self.tap([shift_kc, step[1]] if step[2] else [step[1]])
                    else:
                        self.tap([scratch.slots[step[1]]])
                        result["remapped_characters"] += 1
        if scratch.conflicts:
            result["keymap_conflicts"] = scratch.conflicts
        if scratch.restore_failed:
            result["keymap_restore_failed"] = True  # retried by the next type
        return result

    # --- pointer -----------------------------------------------------------

    def move(self, x, y):
        self.xtst.XTestFakeMotionEvent(self.dpy, self.screen, x, y, 0)
        self.sync()

    def button(self, number, count=1, interval=CLICK_INTERVAL):
        try:
            for i in range(count):
                self._buttons_held.append(number)  # track first so cleanup covers an interrupted press
                self.xtst.XTestFakeButtonEvent(self.dpy, number, 1, 0)
                self.x11.XFlush(self.dpy)
                time.sleep(0.01)
                self.xtst.XTestFakeButtonEvent(self.dpy, number, 0, 0)
                self._buttons_held.remove(number)
                self.x11.XFlush(self.dpy)
                if i + 1 < count:
                    time.sleep(interval)
        finally:
            self.release_all()
        self.sync()


# ---------------------------------------------------------------------------
# Selections (clipboard reading)
# ---------------------------------------------------------------------------

SELECTIONS = {"clipboard": "CLIPBOARD", "primary": "PRIMARY"}
# Text targets in order of preference; the first one the owner accepts wins.
TEXT_TARGETS = ("UTF8_STRING", "text/plain;charset=utf-8", "STRING")
UTF8_TYPES = ("UTF8_STRING", "text/plain;charset=utf-8")


def decode_selection_text(data, type_name):
    """Decode selection bytes by the property type the owner reported.

    STRING is ISO Latin-1 (ICCCM); everything else is read as UTF-8, which
    also covers ASCII-only COMPOUND_TEXT. Trailing NULs some owners append
    are dropped.
    """
    data = bytes(data).rstrip(b"\0")
    return data.decode("latin-1" if type_name == "STRING" else "utf-8", "replace")


def _wait_event(conn, timeout, want):
    """Next event from conn matching want(event); raises clipboard_timeout."""
    deadline = time.monotonic() + timeout
    while True:
        ev = conn.next_event(max(0.0, deadline - time.monotonic()))
        if ev is None:
            raise CuError("clipboard_timeout",
                          "the owner of the %s selection did not answer within %g s" % (conn.selection, timeout),
                          "the app that copied may be busy, frozen or gone; copy again and retry")
        if want(ev):
            return ev


def _check_size(total, limit):
    if total > limit:
        raise CuError("clipboard_too_large", "the selection holds more than %d bytes" % limit,
                      "copy less text at a time")


def _read_incr(conn, timeout, limit):
    """Receive an INCR transfer: one property chunk per PropertyNotify, ended by an empty chunk."""
    chunks, total, type_name = [], 0, None
    while True:
        _wait_event(conn, timeout, lambda ev: ev == ("property", True))
        chunk_type, fmt, data = conn.get_property(delete=True)  # deleting asks for the next chunk
        if not data:
            return type_name, b"".join(chunks)
        if fmt != 8:
            raise CuError("unsupported_target", "the selection owner sent non-text INCR data (format %d)" % fmt)
        total += len(data)
        _check_size(total, limit)
        chunks.append(data)
        type_name = type_name or chunk_type


def read_selection(conn, targets=TEXT_TARGETS, timeout=CLIPBOARD_TIMEOUT, limit=MAX_CLIPBOARD_BYTES):
    """Fetch the selection as text through `conn` (ICCCM conversion protocol).

    conn provides: selection (name), has_owner(), convert(target),
    next_event(timeout) -> ("selection", converted) | ("property", is_new_value)
    | None on timeout, and get_property(delete) -> (type name, format, bytes).
    Returns (type name, text).
    """
    if not conn.has_owner():
        raise CuError("clipboard_empty", "the %s selection is empty (no application owns it)" % conn.selection,
                      "copy something first, e.g. select text and run `cu key ctrl+c`, then wait briefly")
    for target in targets:
        conn.convert(target)
        _, converted = _wait_event(conn, timeout, lambda ev: ev[0] == "selection")
        if not converted:
            continue  # owner refused this target; try the next one
        type_name, fmt, data = conn.get_property(delete=True)
        if type_name == "INCR":
            incr_type, data = _read_incr(conn, timeout, limit)
            type_name = incr_type or target
        elif type_name is None or fmt != 8:
            continue
        _check_size(len(data), limit)
        return type_name, decode_selection_text(data, type_name)
    raise CuError("unsupported_target", "the %s selection owner offers no text (%s)"
                  % (conn.selection, ", ".join(targets)),
                  "the copied content may be an image or files; copy text instead")


def selection_timestamp(conn, timeout):
    """When the owner took the selection (ICCCM TIMESTAMP target), or None."""
    conn.convert("TIMESTAMP")
    try:
        _, converted = _wait_event(conn, timeout, lambda ev: ev[0] == "selection")
    except CuError:
        return None
    if not converted:
        return None
    _type, fmt, data = conn.get_property(delete=True)
    if fmt != 32 or not data:
        return None
    return int.from_bytes(data[:ctypes.sizeof(ctypes.c_long)], sys.byteorder) & 0xFFFFFFFF


class _XSelectionEvent(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                ("display", ctypes.c_void_p), ("requestor", ctypes.c_ulong), ("selection", ctypes.c_ulong),
                ("target", ctypes.c_ulong), ("property", ctypes.c_ulong), ("time", ctypes.c_ulong)]


class _XPropertyEvent(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                ("display", ctypes.c_void_p), ("window", ctypes.c_ulong), ("atom", ctypes.c_ulong),
                ("time", ctypes.c_ulong), ("state", ctypes.c_int)]


class _XEvent(ctypes.Union):
    _fields_ = [("type", ctypes.c_int), ("xselection", _XSelectionEvent),
                ("xproperty", _XPropertyEvent), ("pad", ctypes.c_long * 24)]


X_PROPERTY_NOTIFY = 28
X_SELECTION_NOTIFY = 31
X_PROPERTY_NEW_VALUE = 0
X_PROPERTY_CHANGE_MASK = 1 << 22
PROPERTY_CHUNK_LONGS = 1 << 20  # read properties 4 MiB at a time


class SelectionConn:
    """Requests one selection through a private unmapped window (see read_selection)."""

    def __init__(self, xd, selection):
        self.xd, self.x11, self.dpy = xd, xd.x11, xd.dpy
        self.selection = selection
        self._atoms = {}
        self.sel_atom = self.atom(selection)
        self.prop = self.atom("CU_SELECTION")
        self.win = self.x11.XCreateSimpleWindow(self.dpy, xd.root, 0, 0, 1, 1, 0, 0, 0)
        self.x11.XSelectInput(self.dpy, self.win, X_PROPERTY_CHANGE_MASK)
        self.fd = self.x11.XConnectionNumber(self.dpy)
        self._event = _XEvent()

    def close(self):
        if self.win:
            self.x11.XDestroyWindow(self.dpy, self.win)
            self.x11.XFlush(self.dpy)
            self.win = 0

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()
        return False

    def atom(self, name):
        if name not in self._atoms:
            self._atoms[name] = self.x11.XInternAtom(self.dpy, name.encode(), 0)
        return self._atoms[name]

    def atom_name(self, atom):
        for name, value in self._atoms.items():
            if value == atom:
                return name
        ptr = self.x11.XGetAtomName(self.dpy, atom)
        if not ptr:
            return None
        try:
            return ctypes.string_at(ptr).decode("latin-1")
        finally:
            self.x11.XFree(ptr)

    def owner(self):
        return self.x11.XGetSelectionOwner(self.dpy, self.sel_atom)

    def has_owner(self):
        return bool(self.owner())

    def convert(self, target):
        self.x11.XConvertSelection(self.dpy, self.sel_atom, self.atom(target), self.prop, self.win, 0)
        self.x11.XFlush(self.dpy)

    def next_event(self, timeout):
        deadline = time.monotonic() + timeout
        ev = self._event
        while True:
            while self.x11.XPending(self.dpy):
                self.x11.XNextEvent(self.dpy, ctypes.byref(ev))
                if (ev.type == X_SELECTION_NOTIFY and ev.xselection.requestor == self.win
                        and ev.xselection.selection == self.sel_atom):
                    return ("selection", ev.xselection.property != 0)
                if (ev.type == X_PROPERTY_NOTIFY and ev.xproperty.window == self.win
                        and ev.xproperty.atom == self.prop):
                    return ("property", ev.xproperty.state == X_PROPERTY_NEW_VALUE)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            select.select([self.fd], [], [], remaining)

    def get_property(self, delete):
        """(type name, format, bytes) of our property; (None, 0, b"") when unset."""
        chunks, offset, type_name, fmt = [], 0, None, 0
        while True:
            atype, afmt = ctypes.c_ulong(), ctypes.c_int()
            nitems, after = ctypes.c_ulong(), ctypes.c_ulong()
            ptr = ctypes.POINTER(ctypes.c_ubyte)()
            status = self.x11.XGetWindowProperty(
                self.dpy, self.win, self.prop, offset, PROPERTY_CHUNK_LONGS, 0, 0,  # AnyPropertyType
                ctypes.byref(atype), ctypes.byref(afmt), ctypes.byref(nitems), ctypes.byref(after),
                ctypes.byref(ptr))
            if status != 0:
                raise CuError("clipboard_failed", "cannot read the converted selection property")
            try:
                if not atype.value:
                    return None, 0, b""
                fmt = afmt.value
                unit = 1 if fmt == 8 else 2 if fmt == 16 else ctypes.sizeof(ctypes.c_long)
                chunks.append(ctypes.string_at(ptr, nitems.value * unit) if ptr else b"")
            finally:
                if ptr:
                    self.x11.XFree(ptr)
            type_name = type_name or self.atom_name(atype.value)
            if not after.value:
                break
            offset += nitems.value * fmt // 32
            _check_size(offset * 4, MAX_CLIPBOARD_BYTES)
        if delete:
            self.x11.XDeleteProperty(self.dpy, self.win, self.prop)
            self.x11.XFlush(self.dpy)
        return type_name, fmt, b"".join(chunks)


def write_private_text(path, text):
    """Write text as UTF-8 to path (mode 0600, atomic); returns (abs path, bytes)."""
    path = os.path.abspath(os.path.expanduser(path))
    parent = os.path.dirname(path)
    if not os.path.isdir(parent):
        raise CuError("bad_path", "directory does not exist: %s" % parent)
    data = text.encode("utf-8")
    tmp = "%s.tmp-%d" % (path, os.getpid())
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.replace(tmp, path)
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise CuError("bad_path", "cannot write %s: %s" % (path, exc.strerror or exc))
    return path, len(data)


# ---------------------------------------------------------------------------
# Window metadata (xprop) and screenshots (xwd)
# ---------------------------------------------------------------------------

def run_tool(argv, binary=False, timeout=20):
    try:
        proc = subprocess.run(argv, capture_output=True, timeout=timeout)
    except FileNotFoundError:
        raise CuError("tool_missing", "%s is not installed" % argv[0], "install the %s package" % argv[0])
    except subprocess.TimeoutExpired:
        raise CuError("tool_timeout", "%s timed out" % argv[0], display_hint())
    if proc.returncode != 0:
        msg = proc.stderr.decode("utf-8", "replace").strip() or "exit status %d" % proc.returncode
        raise CuError("tool_failed", "%s failed: %s" % (argv[0], msg), display_hint())
    return proc.stdout if binary else proc.stdout.decode("utf-8", "replace")


def parse_active_window(output):
    """Parse `xprop -root _NET_ACTIVE_WINDOW`; returns int window id or None.

    Handles both "window id # 0x1a00003" and "window id # 0x1a00003, 0x0".
    """
    m = re.search(r"window id # (0x[0-9a-fA-F]+)", output)
    if not m:
        return None
    wid = int(m.group(1), 16)
    return wid or None


_XPROP_STR = r'"((?:[^"\\]|\\.)*)"'


def _unescape(s):
    return re.sub(r"\\(.)", r"\1", s)


def parse_window_props(output):
    props = {}
    for line in output.splitlines():
        name, _, rest = line.partition("(")
        name = name.strip()
        if name == "WM_TRANSIENT_FOR":  # printed without "="
            m = re.search(r"window id # (0x[0-9a-fA-F]+)", rest)
            if m:
                props["transient_for"] = m.group(1)
            continue
        if "=" not in line:
            continue
        value = line.split("=", 1)[1].strip()
        if name in ("_NET_WM_NAME", "WM_NAME"):
            m = re.match(_XPROP_STR, value)
            if m:
                props.setdefault("title", _unescape(m.group(1)))
        elif name == "WM_CLASS":
            parts = [_unescape(p) for p in re.findall(_XPROP_STR, value)]
            if parts:
                props["instance"] = parts[0]
                props["class"] = parts[-1]
        elif name == "_NET_WM_PID":
            m = re.match(r"(\d+)", value)
            if m:
                props["pid"] = int(m.group(1))
        elif name == "_NET_WM_WINDOW_TYPE":
            types = re.findall(r"_NET_WM_WINDOW_TYPE_(\w+)", value)
            if types:
                props["type"] = [t.lower() for t in types]
    return props


def active_window(xd=None):
    out = run_tool(["xprop", "-display", display_name(), "-root", "_NET_ACTIVE_WINDOW"])
    wid = parse_active_window(out)
    if wid is None:
        return None
    info = {"id": "0x%x" % wid}
    try:
        props = run_tool(["xprop", "-display", display_name(), "-id", "0x%x" % wid,
                          "_NET_WM_NAME", "WM_NAME", "WM_CLASS", "_NET_WM_PID",
                          "_NET_WM_WINDOW_TYPE", "WM_TRANSIENT_FOR"])
        info.update(parse_window_props(props))
    except CuError:
        info["error"] = "window properties unavailable"
    if xd is not None:
        geom = xd.window_geometry(wid)
        if geom:
            info["geometry"] = geom
    return info


# WM classes (or instances) of browsers that open a new tab on Ctrl+T, with the
# usual channel suffixes and reverse-DNS or snap prefixes (org.mozilla.firefox,
# firefox_firefox). Whole names only: chromium-bsu is a game.
BROWSER_CLASS = re.compile(
    r"(?:.*[._])?(?:firefox|librewolf|waterfox|floorp|icecat|tor[ -]browser|zen"
    r"|chromium|(?:google[- ])?chrome|brave|microsoft-edge|vivaldi|opera)"
    r"(?:[- ]?(?:browser|esr|stable|beta|dev|unstable|nightly|aurora|snapshot|developer|edition"
    r"|default))*", re.IGNORECASE)


def window_classes(win):
    return [win[k] for k in ("class", "instance") if win.get(k)]


def title_contains(title, text):
    return title is not None and text in title


def is_dialog(win):
    return "dialog" in win.get("type", ()) or "transient_for" in win


def default_screenshot_path():
    try:
        fd, path = tempfile.mkstemp(prefix="cu-%s-" % time.strftime("%Y%m%d-%H%M%S"), suffix=".png")
    except OSError as exc:
        raise CuError("bad_path", "cannot create a screenshot file in the temp directory: %s"
                      % (exc.strerror or exc), "pass an explicit PNG path")
    os.close(fd)
    return path


def take_screenshot(path=None):
    path = os.path.abspath(os.path.expanduser(path or default_screenshot_path()))
    parent = os.path.dirname(path)
    if not os.path.isdir(parent):
        raise CuError("bad_path", "directory does not exist: %s" % parent)
    data = run_tool(["xwd", "-root", "-silent", "-display", display_name()], binary=True)
    width, height, rows = xwd_to_rgb(data)
    png = png_bytes(width, height, rows)
    tmp = "%s.tmp-%d" % (path, os.getpid())
    try:
        with open(tmp, "wb") as fh:
            fh.write(png)
        os.replace(tmp, path)
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise CuError("bad_path", "cannot write %s: %s" % (path, exc.strerror or exc))
    return {"path": path, "width": width, "height": height}


# ---------------------------------------------------------------------------
# Condition waits
# ---------------------------------------------------------------------------

WAIT_CONDITIONS = ("title-change", "title-contains", "title-matches", "window-change", "stable",
                   "clipboard-change")
BASELINE_CONDITIONS = {"title-change", "window-change", "clipboard-change"}
CONDITION_SYNTAX = ("title-change, title-contains=TEXT, title-matches=REGEX, window-change, "
                    "stable[=SECONDS], clipboard-change[=primary]")


def parse_condition(spec):
    """Parse NAME[=VALUE] into a condition dict (timeout etc. are added by the caller)."""
    if not isinstance(spec, str) or not spec:
        raise usage_error("wait condition must be a non-empty string", "conditions: " + CONDITION_SYNTAX)
    name, sep, arg = spec.partition("=")
    if name not in WAIT_CONDITIONS:
        raise usage_error("unknown wait condition %r" % name, "conditions: " + CONDITION_SYNTAX)
    cond = {"name": name}
    if name in ("title-change", "window-change"):
        if sep:
            raise usage_error("%s takes no value" % name)
    elif name in ("title-contains", "title-matches"):
        if not arg:
            raise usage_error("%s needs a value" % name, "example: %s=Example" % name)
        if name == "title-matches":
            try:
                re.compile(arg)
            except (re.error, OverflowError, ValueError, RecursionError) as exc:
                raise usage_error("invalid regular expression %r: %s" % (arg, exc))
        cond["text"] = arg
    elif name == "stable":
        seconds = DEFAULT_STABLE_SECONDS
        if sep:
            try:
                seconds = float(arg)
            except ValueError:
                seconds = -1.0
        if not 0 < seconds <= MAX_WAIT_SECONDS:  # also rejects NaN
            raise usage_error("stable needs a number of seconds above 0 and up to %g" % MAX_WAIT_SECONDS)
        cond["seconds"] = seconds
    else:
        selection = arg if sep else "clipboard"
        if selection not in SELECTIONS:
            raise usage_error("clipboard-change takes clipboard or primary")
        cond["selection"] = selection
    return cond


def parse_baseline(cond, value):
    """An explicit starting value (`from`) for title-change or window-change."""
    if cond["name"] == "title-change":
        if not isinstance(value, str):
            raise usage_error("field 'from' must be the old title as a string")
        return {"window": None, "title": value}
    if cond["name"] == "window-change":
        wid = None
        if _is_int(value):
            wid = value
        elif isinstance(value, str):
            try:
                wid = int(value, 0)
            except ValueError:
                pass
        if wid is None or wid < 0:
            raise usage_error("field 'from' must be a window id such as 0x1a00003")
        return {"window": wid or None, "title": None}
    raise usage_error("'from' only applies to title-change and window-change")


class DesktopProbe:
    """Reads the live values that wait conditions compare."""

    def __init__(self, session):
        self.session = session
        self.deadline = None  # set by wait_until; caps how long one probe may block

    def _tool_timeout(self):
        if self.deadline is None:
            return 20
        return max(0.5, self.deadline - time.monotonic() + 0.5)

    def _request_timeout(self):
        if self.deadline is None:
            return SELECTION_PROBE_TIMEOUT
        return max(0.05, min(SELECTION_PROBE_TIMEOUT, self.deadline - time.monotonic()))

    def window(self):
        wid = parse_active_window(run_tool(["xprop", "-display", display_name(), "-root", "_NET_ACTIVE_WINDOW"],
                                           timeout=self._tool_timeout()))
        title = None
        if wid is not None:
            try:
                title = parse_window_props(run_tool(["xprop", "-display", display_name(), "-id", "0x%x" % wid,
                                                     "_NET_WM_NAME", "WM_NAME"],
                                                    timeout=self._tool_timeout())).get("title")
            except CuError:
                # The window went away between the two calls: its title is unknown, not changed.
                return {"window": wid, "title": None, "lost": True}
        return {"window": wid, "title": title}

    def selection(self, name, base=None):
        """Owner, TIMESTAMP and text digest; skips the slow parts once base already differs."""
        xd, sel = self.session.xd, SELECTIONS[name]
        state = {"owner": None, "timestamp": None, "digest": None, "length": None}
        with SelectionConn(xd, sel) as conn:
            state["owner"] = conn.owner() or None
        if state["owner"] is None or (base is not None and base["owner"] != state["owner"]):
            return state
        with SelectionConn(xd, sel) as conn:
            state["timestamp"] = selection_timestamp(conn, self._request_timeout())
        if base is not None and None not in (base["timestamp"], state["timestamp"]) \
                and base["timestamp"] != state["timestamp"]:
            return state
        with SelectionConn(xd, sel) as conn:
            try:
                _, text = read_selection(conn, timeout=self._request_timeout())
            except CuError:
                return state  # busy owner or no text: compare owner and timestamp only
        state["digest"] = hashlib.sha256(text.encode("utf-8")).hexdigest()
        state["length"] = len(text)
        return state

    def frame(self):
        return xwd_frame(run_tool(["xwd", "-root", "-silent", "-display", display_name()], binary=True,
                                  timeout=self._tool_timeout()))


def observe_condition(cond, probe, base=None):
    name = cond["name"]
    if name == "stable":
        return probe.frame()
    if name == "clipboard-change":
        return probe.selection(cond["selection"], base)
    return probe.window()


def selection_changed(base, cur):
    """Owner differs, or a TIMESTAMP or text both sides know differs."""
    if base["owner"] != cur["owner"]:
        return True
    if cur["owner"] is None:
        return False
    return any(base[k] is not None and cur[k] is not None and base[k] != cur[k] for k in ("timestamp", "digest"))


def condition_met(cond, base, cur):
    name = cond["name"]
    if name == "window-change":
        return cur["window"] != base["window"]
    if name != "clipboard-change" and cur.get("lost"):
        return False
    if name == "title-change":
        return cur["title"] != base["title"]
    if name == "window-change":
        return cur["window"] != base["window"]
    if name == "title-contains":
        return title_contains(cur["title"], cond["text"])
    if name == "title-matches":
        return cur["title"] is not None and re.search(cond["text"], cur["title"]) is not None
    if name == "clipboard-change":
        return selection_changed(base, cur)
    raise ValueError(name)


def _window_hex(wid):
    return None if wid is None else "0x%x" % wid


def condition_report(cond, base, cur, elapsed, polls, stable_for=None):
    name = cond["name"]
    out = {"condition": name, "elapsed": round(elapsed, 2), "polls": polls}
    if name in ("title-contains", "title-matches"):
        out["text" if name == "title-contains" else "pattern"] = cond["text"]
    if name in ("title-change", "title-contains", "title-matches", "window-change"):
        out["title"] = cur["title"]
        out["window"] = _window_hex(cur["window"])
        if name == "title-change":
            out["from"] = base["title"]
        elif name == "window-change":
            out["from"] = _window_hex(base["window"])
    elif name == "clipboard-change":
        out["selection"] = cond["selection"]
        out["owner"] = _window_hex(cur["owner"])
        if cur["timestamp"] is not None:
            out["timestamp"] = cur["timestamp"]
        if cur["length"] is not None:
            out["length"] = cur["length"]
    else:
        out.update(seconds=cond["seconds"], tolerance=cond["tolerance"], stable_for=round(stable_for, 2))
    return out


TIMEOUT_HINTS = {
    "stable": "the screen kept changing (animation, spinner, blinking cursor, video); raise --tolerance, "
              "observe to see what moves, or use a fixed wait",
    "clipboard-change": "nothing was copied, or the same app copied again without a new TIMESTAMP; "
                        "check focus and the selection, then read it with `cu clipboard`",
}
CHANGE_HINT = ("the change may have happened before the wait started; use --wait-for on the action or a "
               "batch, then observe")


def wait_until(cond, probe, baseline=None, clock=time.monotonic, sleep=time.sleep):
    """Poll until cond is met; returns a report or raises wait_timeout with the last value seen.

    Each probe's own blocking (xprop, xwd, selection requests) is capped near the deadline.
    """
    if hasattr(probe, "deadline"):
        probe.deadline = time.monotonic() + cond["timeout"]
    try:
        return _wait_loop(cond, probe, baseline, clock, sleep)
    finally:
        if hasattr(probe, "deadline"):
            probe.deadline = None


def _wait_loop(cond, probe, baseline, clock, sleep):
    name = cond["name"]
    start = clock()
    deadline = start + cond["timeout"]
    if name in BASELINE_CONDITIONS:
        baseline = cond.get("from") or baseline
        if baseline is None:
            baseline = observe_condition(cond, probe)
    polls, anchor, anchor_at = 0, None, None
    while True:
        cur = observe_condition(cond, probe, baseline)
        polls += 1
        now = clock()
        if name == "stable":
            if anchor is None or changed_pixels(anchor, cur, cond["tolerance"]) > cond["tolerance"]:
                anchor, anchor_at = cur, now
            met = now - anchor_at >= cond["seconds"]
        else:
            met = condition_met(cond, baseline, cur)
        report = condition_report(cond, baseline, cur, now - start, polls,
                                  None if anchor_at is None else now - anchor_at)
        if met:
            report["met"] = True
            return report
        if now >= deadline:
            hint = TIMEOUT_HINTS.get(name, CHANGE_HINT if name in BASELINE_CONDITIONS else
                                     "observe to see the current window title")
            raise CuError("wait_timeout", "%s not met within %g s" % (name, cond["timeout"]), hint,
                          met=False, **report)
        sleep(min(WAIT_POLL_INTERVAL, deadline - now))


# ---------------------------------------------------------------------------
# Actions (shared by CLI and batch)
# ---------------------------------------------------------------------------

BUTTONS = {"left": 1, "middle": 2, "right": 3}
SCROLL_BUTTONS = {"up": 4, "down": 5, "left": 6, "right": 7}


def _is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


def _is_number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _require(params, key, check, desc):
    if key not in params:
        raise usage_error("missing required field %r" % key)
    if not check(params[key]):
        raise usage_error("field %r must be %s" % (key, desc))
    return params[key]


def _optional(params, key, check, desc, default):
    if key not in params or params[key] is None:
        return default
    if not check(params[key]):
        raise usage_error("field %r must be %s" % (key, desc))
    return params[key]


def _nonempty_str(v):
    return isinstance(v, str) and v != ""


# Each spec: allowed fields and a validator that normalizes params.
def _v_none(p):
    return {}


def _v_path(p):
    return {"path": _optional(p, "path", _nonempty_str, "a non-empty string", None)}


def _v_open_tab(p):
    url = _require(p, "url", _nonempty_str, "a non-empty string")
    if any(c in url for c in "\r\n"):
        raise usage_error("url must not contain newlines")
    text_keysyms(url)
    return {"url": url}


def _v_key(p):
    keys = _require(p, "keys", _nonempty_str, "a non-empty string like 'ctrl+l'")
    parse_chord(keys)
    return {"keys": keys}


def _v_type(p):
    text = _require(p, "text", lambda v: isinstance(v, str), "a string")
    if text == "":
        raise usage_error("text must not be empty")
    if len(text) > MAX_TEXT_LENGTH:
        raise usage_error("text is longer than %d characters" % MAX_TEXT_LENGTH, "split it into several type actions")
    text_keysyms(text)  # reject untypeable characters before any input is sent
    return {"text": text}


def _v_point(p):
    return {"x": _require(p, "x", _is_int, "an integer pixel"),
            "y": _require(p, "y", _is_int, "an integer pixel")}


def _v_click(p):
    out = _v_point(p)
    out["button"] = _optional(p, "button", lambda v: isinstance(v, str) and v in BUTTONS, "one of left, middle, right", "left")
    out["count"] = _optional(p, "count", lambda v: _is_int(v) and 1 <= v <= MAX_CLICK_COUNT,
                             "an integer from 1 to %d" % MAX_CLICK_COUNT, 1)
    out["hover"] = float(_optional(p, "hover", lambda v: _is_number(v) and v == v and 0 <= v <= MAX_HOVER_SECONDS,
                                   "a number of seconds from 0 to %g" % MAX_HOVER_SECONDS, DEFAULT_HOVER))
    return out


def _v_scroll(p):
    direction = _require(p, "direction", lambda v: isinstance(v, str) and v in SCROLL_BUTTONS, "one of up, down, left, right")
    amount = _optional(p, "amount", lambda v: _is_int(v) and 1 <= v <= MAX_SCROLL_TICKS,
                       "an integer from 1 to %d ticks" % MAX_SCROLL_TICKS, 3)
    return {"direction": direction, "amount": amount}


def _wait_options(p, field):
    """The condition in p[field] with its timeout and tolerance, or None when absent."""
    if p.get(field) is None:
        for key in ("timeout", "tolerance"):
            if p.get(key) is not None:
                raise usage_error("field %r needs %r" % (key, field), "conditions: " + CONDITION_SYNTAX)
        return None
    cond = parse_condition(p[field])
    cond["timeout"] = float(_optional(p, "timeout", lambda v: _is_number(v) and v == v and 0 <= v <= MAX_WAIT_SECONDS,
                                      "a number of seconds from 0 to %g" % MAX_WAIT_SECONDS, DEFAULT_WAIT_TIMEOUT))
    if cond["name"] == "stable":
        cond["tolerance"] = _optional(p, "tolerance", lambda v: _is_int(v) and 0 <= v <= MAX_STABLE_TOLERANCE,
                                      "an integer number of pixels from 0 to %d" % MAX_STABLE_TOLERANCE, 0)
        if cond["seconds"] > cond["timeout"]:
            raise usage_error("stable period %g s is longer than the timeout %g s" % (cond["seconds"], cond["timeout"]),
                              "raise the timeout")
    elif p.get("tolerance") is not None:
        raise usage_error("tolerance only applies to the stable condition")
    return cond


def _v_wait(p):
    if (p.get("seconds") is None) == (p.get("until") is None):
        raise usage_error("wait needs either seconds or a condition",
                          "examples: `cu wait 1`, `cu wait --title-change`; in a batch "
                          '{"action": "wait", "seconds": 1} or {"action": "wait", "until": "title-change"}')
    if p.get("until") is None:
        for key in ("timeout", "tolerance", "from"):
            if p.get(key) is not None:
                raise usage_error("field %r only applies with 'until'" % key)
        seconds = _require(p, "seconds", lambda v: _is_number(v) and v == v and 0 <= v <= MAX_WAIT_SECONDS,
                           "a number of seconds from 0 to %g" % MAX_WAIT_SECONDS)
        return {"seconds": float(seconds)}
    cond = _wait_options(p, "until")
    if p.get("from") is not None:
        cond["from"] = parse_baseline(cond, p["from"])
    return {"until": cond}


EXPECT_FIELDS = ("expect_title", "expect_class")
INPUT_FIELDS = {"wait_for", "timeout", "tolerance"} | set(EXPECT_FIELDS)


def expectations(p):
    """The non-null expect_* fields of p, checked."""
    out = {}
    for field in EXPECT_FIELDS:
        value = _optional(p, field, _nonempty_str, "a non-empty string (or null in a batch item)", None)
        if value is not None:
            out[field] = value
    return out


def _input(validator):
    """Adds the optional fields shared by all input actions: wait_for etc. and expect_*."""
    def validate(p):
        out = validator(p)
        cond = _wait_options(p, "wait_for")
        if cond:
            out["wait_for"] = cond
        out.update(expectations(p))
        return out
    return validate


def _v_clipboard(p):
    return {"selection": _optional(p, "selection", lambda v: isinstance(v, str) and v in SELECTIONS,
                                   "one of clipboard, primary", "clipboard"),
            "out": _optional(p, "out", _nonempty_str, "a non-empty string", None)}


VALIDATORS = {
    "info": (set(), _v_none),
    "observe": ({"path"}, _v_path),
    "screenshot": ({"path"}, _v_path),
    "open-tab": ({"url"} | INPUT_FIELDS, _input(_v_open_tab)),
    "key": ({"keys"} | INPUT_FIELDS, _input(_v_key)),
    "type": ({"text"} | INPUT_FIELDS, _input(_v_type)),
    "click": ({"x", "y", "button", "count", "hover"} | INPUT_FIELDS, _input(_v_click)),
    "move": ({"x", "y"} | INPUT_FIELDS, _input(_v_point)),
    "scroll": ({"direction", "amount"} | INPUT_FIELDS, _input(_v_scroll)),
    "wait": ({"seconds", "until", "timeout", "tolerance", "from"}, _v_wait),
    "clipboard": ({"selection", "out"}, _v_clipboard),
}
INPUT_ACTIONS = {"open-tab", "key", "type", "click", "move", "scroll"}


def validate_action(item, defaults=None):
    """Check one action; `defaults` are expect_* values for input actions that do not set their own."""
    if not isinstance(item, dict):
        raise usage_error("each batch item must be a JSON object")
    action = item.get("action")
    if not isinstance(action, str) or action not in VALIDATORS:
        raise usage_error("unknown action %r" % (action,), "valid actions: " + ", ".join(sorted(VALIDATORS)))
    allowed, validator = VALIDATORS[action]
    unknown = sorted(set(item) - allowed - {"action"})
    if unknown:
        raise usage_error("unknown field(s) for %s: %s" % (action, ", ".join(unknown)))
    if defaults and action in INPUT_ACTIONS:
        item = dict(defaults, **item)  # an explicit null in the item turns the default off
    params = validator(item)
    params["action"] = action
    return params


class Session:
    """Lazily opens the display once for a command or batch."""

    def __init__(self):
        self._xd = None
        self.probe = DesktopProbe(self)
        self.captured = None

    @property
    def xd(self):
        if self._xd is None:
            self._xd = XDisplay()
        return self._xd

    def close(self):
        if self._xd is not None:
            self._xd.close()
            self._xd = None

    def check_point(self, x, y):
        xd = self.xd
        if not (0 <= x < xd.width and 0 <= y < xd.height):
            raise CuError("out_of_bounds", "point (%d, %d) is outside the %dx%d display" % (x, y, xd.width, xd.height),
                          "coordinates are native screenshot pixels", exit_code=EXIT_USAGE)

    def info(self):
        xd = self.xd
        return {
            "display": {"name": display_name(), "width": xd.width, "height": xd.height},
            "pointer": xd.pointer(),
            "active_window": active_window(xd),
        }

    def preflight(self, p):
        """Checks that need the display but no input, so they can fail before the input lock."""
        if p["action"] == "key":
            self.xd.resolve_chord(p["keys"])
        elif p["action"] in ("click", "move"):
            self.check_point(p["x"], p["y"])

    def check_window(self, p):
        """Fail unless the active window is the one this input action is meant for."""
        expected = {k[len("expect_"):]: p[k] for k in EXPECT_FIELDS if k in p}
        open_tab = p["action"] == "open-tab"
        if not expected and not open_tab:
            return
        win = active_window(self.xd)
        have = win or {}
        problems = []
        if win is None:
            problems.append("there is no active window")
        else:
            if "title" in expected and not title_contains(have.get("title"), expected["title"]):
                problems.append("the title does not contain %r" % expected["title"])
            if "class" in expected:
                want = expected["class"].casefold()
                if not any(want in c.casefold() for c in window_classes(have)):
                    problems.append("neither class nor instance contains %r" % expected["class"])
            elif open_tab and not any(BROWSER_CLASS.fullmatch(c) for c in window_classes(have)):
                problems.append("it is not a known browser")
            if open_tab and is_dialog(have):
                problems.append("it is a dialog")
        if not problems:
            return
        if open_tab:
            expected["browser_window"] = True
        hint = "observe to see which window has focus, then focus or close windows as needed"
        if "it is not a known browser" in problems:
            hint += "; for a browser that cu does not know, pass --expect-class (expect_class)"
        raise CuError("unexpected_window", "unexpected active window: %s; %s did not send any input"
                      % (" and ".join(problems), p["action"]), hint, expected=expected, active_window=win)

    def run(self, p, capture=None, baseline=None):
        """Run one validated action and its optional wait_for.

        The caller holds the input lock for input actions, so no other cu
        process can change the baseline or the active window here.

        A "change" condition compares against a value recorded at the
        action's commit point: when it starts or, for open-tab, just before
        Enter (the new empty tab already changed the title). `capture` is the
        next batch wait's condition; its value lands in self.captured.
        `baseline` is such a value for this action's own `until`.
        """
        action = p["action"]
        result = {"action": action}
        own = p.get("wait_for")
        taken = {}
        self.captured = None

        def commit():
            for key, cond in (("capture", capture), ("own", own)):
                if cond and cond["name"] in BASELINE_CONDITIONS and "from" not in cond:
                    taken[key] = observe_condition(cond, self.probe)

        if action != "open-tab":
            commit()
        if action in INPUT_ACTIONS:
            self.check_window(p)  # last, right before the first event
        if action == "info":
            result.update(self.info())
        elif action == "observe":
            result.update(self.info())
            result["screenshot"] = take_screenshot(p.get("path"))
            result["next"] = "view the PNG at screenshot.path before acting"
        elif action == "screenshot":
            result["screenshot"] = take_screenshot(p.get("path"))
        elif action == "open-tab":
            xd = self.xd
            xd.press_chord("ctrl+t")
            time.sleep(OPEN_TAB_SETTLE)
            xd.type_text(p["url"])
            commit()
            xd.press_chord("Return")
            result["url"] = p["url"]
            if not own:
                result["next"] = ("page load is not detected; add --wait-for title-change (or run "
                                  "`cu wait --stable`), then observe")
        elif action == "key":
            self.xd.press_chord(p["keys"])
            result["keys"] = p["keys"]
        elif action == "type":
            typed = self.xd.type_text(p["text"])
            result["characters"] = len(p["text"])
            result.update(typed)
        elif action == "click":
            self.check_point(p["x"], p["y"])
            # Hover-sensitive widgets need the pointer over them for a moment;
            # skip the pause when it is already there (repeated clicks).
            hover = p["hover"]
            if self.xd.pointer() == {"x": p["x"], "y": p["y"]}:
                hover = 0.0
            self.xd.move(p["x"], p["y"])
            time.sleep(max(hover, CLICK_SETTLE))
            self.xd.button(BUTTONS[p["button"]], p["count"])
            result.update({"x": p["x"], "y": p["y"], "button": p["button"], "count": p["count"], "hover": hover})
        elif action == "move":
            self.check_point(p["x"], p["y"])
            self.xd.move(p["x"], p["y"])
            result.update({"x": p["x"], "y": p["y"]})
        elif action == "scroll":
            self.xd.button(SCROLL_BUTTONS[p["direction"]], p["amount"], SCROLL_INTERVAL)
            result.update({"direction": p["direction"], "amount": p["amount"], "pointer": self.xd.pointer()})
        elif action == "wait" and "until" in p:
            result.update(wait_until(p["until"], self.probe, baseline))
        elif action == "wait":
            time.sleep(p["seconds"])
            result["seconds"] = p["seconds"]
        elif action == "clipboard":
            with SelectionConn(self.xd, SELECTIONS[p["selection"]]) as conn:
                type_name, text = read_selection(conn)
            result.update({"selection": p["selection"], "type": type_name, "length": len(text)})
            if p["out"]:
                result["path"], result["bytes"] = write_private_text(p["out"], text)
            else:
                result["text"] = text
        self.captured = taken.get("capture")
        if own:
            try:
                result["wait"] = wait_until(own, self.probe, taken.get("own"))
            except CuError as exc:
                exc.extra["action_result"] = dict(result)  # the input was sent; only the wait failed
                raise
        return result


def run_single(params):
    """Run one validated command, holding the input lock if it sends input."""
    if params["action"] not in INPUT_ACTIONS:
        session = Session()
        try:
            return session.run(params)
        finally:
            session.close()
    session = Session()
    try:
        session.preflight(params)
    finally:
        session.close()
    # A new connection after locking: Xlib caches the keymap, and the previous
    # holder may have had temporary keys mapped when preflight looked.
    with InputLock():
        session = Session()
        try:
            return session.run(params)
        finally:
            session.close()


def run_batch(items, final_screenshot=None, expect=None):
    """Run a batch; `expect` holds default expect_* fields for its input actions."""
    if isinstance(items, dict) and isinstance(items.get("actions"), list):
        items = items["actions"]
    if not isinstance(items, list):
        raise usage_error("batch input must be a JSON array of action objects")
    if not items:
        raise usage_error("batch is empty")
    defaults = expectations(expect or {})
    validated = []
    for i, item in enumerate(items):
        try:
            validated.append(validate_action(item, defaults))
        except CuError as exc:
            exc.extra["index"] = i
            raise
    session = Session()
    try:
        failed = check_chords(session, validated)
        if failed:
            return failed
    finally:
        session.close()  # run_validated opens a new connection, see run_single
    if not any(params["action"] in INPUT_ACTIONS for params in validated):
        return run_validated(validated, final_screenshot)
    lock = InputLock()
    try:
        lock.acquire()
    except CuError as exc:
        return {"ok": False, "completed": 0, "results": [], "error": exc.to_json()}, exc.exit_code
    try:
        return run_validated(validated, final_screenshot)
    finally:
        lock.release()


def check_chords(session, validated):
    """The batch failure for the first key chord that does not resolve, or None."""
    for i, params in enumerate(validated):
        if params["action"] == "key":
            try:
                session.preflight(params)
            except CuError as exc:
                return {"ok": False, "completed": 0, "results": [], "failed_index": i,
                        "error": exc.to_json()}, exc.exit_code
    return None


def run_validated(validated, final_screenshot):
    session = Session()
    results = []
    try:
        failed = check_chords(session, validated)  # again: the keymap may have changed while waiting for the lock
        if failed:
            return failed
        carry = None
        for i, params in enumerate(validated):
            nxt = validated[i + 1] if i + 1 < len(validated) else None
            capture = nxt.get("until") if nxt and nxt["action"] == "wait" else None
            try:
                results.append(session.run(params, capture=capture, baseline=carry))
                carry = session.captured
            except CuError as exc:
                return {"ok": False, "completed": len(results), "results": results,
                        "failed_index": i, "error": exc.to_json()}, exc.exit_code
        out = {"ok": True, "completed": len(results), "results": results}
        if final_screenshot:
            try:
                out["screenshot"] = take_screenshot(final_screenshot)
            except CuError as exc:
                out.update(ok=False, failed_index=len(validated), error=exc.to_json())
                return out, exc.exit_code
        return out, 0
    finally:
        session.close()


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        raise usage_error(message, "run `%s --help`" % self.prog)


def add_expect(p, scope=""):
    g = p.add_argument_group("check the active window right before sending input (else unexpected_window)")
    g.add_argument("--expect-title", metavar="TEXT",
                   help="%sits title must contain TEXT (case-sensitive)" % scope)
    g.add_argument("--expect-class", metavar="CLASS",
                   help="%sits WM class or instance must contain CLASS (any case)" % scope)
    return p


def add_input_options(p):
    g = p.add_argument_group("wait after the action (polls every %g s)" % WAIT_POLL_INTERVAL)
    g.add_argument("--wait-for", metavar="CONDITION",
                   help="record the value before acting, act, then wait: " + CONDITION_SYNTAX)
    g.add_argument("--timeout", type=float, metavar="SECONDS",
                   help="give up after SECONDS (default %g, max %g)" % (DEFAULT_WAIT_TIMEOUT, MAX_WAIT_SECONDS))
    g.add_argument("--tolerance", type=int, metavar="PIXELS",
                   help="stable only: ignore up to PIXELS changed pixels (default 0)")
    return add_expect(p)


def wait_item(args):
    """Batch-style item for `cu wait`, turning the condition flags into an `until` spec."""
    specs = []
    if args.title_change:
        specs.append("title-change")
    if args.title_contains is not None:
        specs.append("title-contains=" + args.title_contains)
    if args.title_matches is not None:
        specs.append("title-matches=" + args.title_matches)
    if args.window_change:
        specs.append("window-change")
    if args.stable is not None:
        specs.append("stable=%r" % args.stable)
    if args.clipboard_change:
        specs.append("clipboard-change=" + (args.selection or "clipboard"))
    elif args.selection is not None:
        raise usage_error("--selection only applies to --clipboard-change")
    if len(specs) > 1:
        raise usage_error("pick one wait condition", "run several `cu wait` commands in a row instead")
    item = {"action": "wait", "seconds": args.seconds, "until": specs[0] if specs else None,
            "timeout": args.timeout, "tolerance": args.tolerance, "from": args.from_}
    return {k: v for k, v in item.items() if v is not None}


def build_parser():
    parser = JsonArgumentParser(
        prog="cu",
        description="Control the current X11 desktop: screenshots, clicks, keys, text. All output is JSON.",
        epilog=HELP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version="cu " + VERSION)
    sub = parser.add_subparsers(dest="command", metavar="COMMAND", parser_class=JsonArgumentParser)

    sub.add_parser("info", help="focused window title/class/pid/geometry, display size, pointer")
    p = sub.add_parser("observe", help="info plus a screenshot")
    p.add_argument("path", nargs="?", help="PNG path (default: a new file in the temp dir)")
    p = sub.add_parser("screenshot", help="capture the full desktop as PNG")
    p.add_argument("path", nargs="?", help="PNG path (default: a new file in the temp dir)")
    p = add_input_options(sub.add_parser("open-tab", help="Ctrl+T in the focused browser (refused elsewhere), type URL, Enter"))
    p.add_argument("url")
    p = add_input_options(sub.add_parser("key", help="send a key chord such as ctrl+l, alt+Left, Return"))
    p.add_argument("keys")
    p = add_input_options(sub.add_parser(
        "type", help="type literal text (any Unicode; characters missing from the layout use a temporary keymap entry)"))
    p.add_argument("text")
    p = add_input_options(sub.add_parser("click", help="click at desktop pixel X Y"))
    p.add_argument("x", type=int)
    p.add_argument("y", type=int)
    p.add_argument("--button", choices=sorted(BUTTONS), default="left")
    p.add_argument("--count", type=int, default=1, help="1=single, 2=double, 3=triple")
    p.add_argument("--hover", type=float, metavar="SECONDS",
                   help="pause over the target before pressing (default %g, max %g; 0 = click at once; "
                        "skipped when the pointer is already there)" % (DEFAULT_HOVER, MAX_HOVER_SECONDS))
    p = add_input_options(sub.add_parser("move", help="move the pointer to X Y"))
    p.add_argument("x", type=int)
    p.add_argument("y", type=int)
    p = add_input_options(sub.add_parser("scroll", help="wheel ticks at the current pointer position"))
    p.add_argument("direction", choices=sorted(SCROLL_BUTTONS))
    p.add_argument("amount", nargs="?", type=int, default=3)
    p = sub.add_parser("wait", help="sleep for SECONDS (max %g), or poll until a condition is met" % MAX_WAIT_SECONDS,
                       description="Sleep for SECONDS, or poll every %g s until one condition is met. "
                                   "Conditions on change compare with the value when the wait starts; "
                                   "to catch a change your action causes, prefer `--wait-for` on the "
                                   "action or a batch." % WAIT_POLL_INTERVAL)
    p.add_argument("seconds", nargs="?", type=float, help="fixed sleep (instead of a condition)")
    g = p.add_argument_group("conditions (pick one)")
    g.add_argument("--title-change", action="store_true", help="the active window's title changes")
    g.add_argument("--title-contains", metavar="TEXT", help="the active window's title contains TEXT")
    g.add_argument("--title-matches", metavar="REGEX", help="the active window's title matches REGEX (re.search)")
    g.add_argument("--window-change", action="store_true", help="another window becomes active (dialogs, new windows)")
    g.add_argument("--stable", nargs="?", type=float, const=DEFAULT_STABLE_SECONDS, metavar="SECONDS",
                   help="the screen stops changing for SECONDS (default %g)" % DEFAULT_STABLE_SECONDS)
    g.add_argument("--clipboard-change", action="store_true",
                   help="the clipboard owner, TIMESTAMP or text changes")
    g = p.add_argument_group("condition options")
    g.add_argument("--timeout", type=float, metavar="SECONDS",
                   help="give up after SECONDS (default %g, max %g)" % (DEFAULT_WAIT_TIMEOUT, MAX_WAIT_SECONDS))
    g.add_argument("--tolerance", type=int, metavar="PIXELS",
                   help="--stable only: ignore up to PIXELS changed pixels (default 0)")
    g.add_argument("--selection", choices=sorted(SELECTIONS), help="--clipboard-change only (default clipboard)")
    g.add_argument("--from", dest="from_", metavar="VALUE",
                   help="--title-change / --window-change only: compare with this title or window id "
                        "instead of the current one")
    p = sub.add_parser("clipboard", help="print the text on the clipboard (or PRIMARY selection) as JSON")
    p.add_argument("--selection", choices=sorted(SELECTIONS), default="clipboard",
                   help="clipboard = Ctrl+C contents (default); primary = last selected text")
    p.add_argument("--out", metavar="FILE", help="write the text to FILE (UTF-8, mode 0600) instead of the JSON")
    p = sub.add_parser("batch", help="run a JSON action array from FILE or - (stdin)",
                       epilog=HELP_EPILOG, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("file")
    p.add_argument("--screenshot", metavar="PATH", help="capture the final state after the batch")
    add_expect(p, "before every input action that does not set its own: ")
    return parser


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def _interrupt(signum, _frame):
    raise KeyboardInterrupt


def main(argv=None):
    parser = build_parser()
    for sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(sig, _interrupt)  # run cleanup (key release, keymap restore)
        except (ValueError, OSError):
            pass
    try:
        args = parser.parse_args(argv)
        if not args.command:
            parser.print_help()
            return EXIT_USAGE
        if args.command == "batch":
            try:
                if args.file == "-":
                    raw = sys.stdin.read()
                else:
                    with open(args.file, encoding="utf-8") as fh:
                        raw = fh.read()
            except OSError as exc:
                raise usage_error("cannot read batch file: %s" % (exc.strerror or exc))
            try:
                items = json.loads(raw)
            except json.JSONDecodeError as exc:
                raise usage_error("batch input is not valid JSON: %s" % exc)
            expect = {k: getattr(args, k) for k in EXPECT_FIELDS if getattr(args, k) is not None}
            out, code = run_batch(items, args.screenshot, expect)
            emit(out)
            return code
        if args.command == "wait":
            item = wait_item(args)
        else:
            item = {k: v for k, v in vars(args).items() if k != "command" and v is not None}
            item["action"] = args.command
        params = validate_action(item)
        result = run_single(params)
        result["ok"] = True
        emit(dict([("ok", True)] + [(k, v) for k, v in result.items() if k != "ok"]))
        return 0
    except CuError as exc:
        emit({"ok": False, "error": exc.to_json()})
        return exc.exit_code
    except KeyboardInterrupt:
        emit({"ok": False, "error": {"code": "interrupted", "message": "interrupted"}})
        return 130


if __name__ == "__main__":
    sys.exit(main())
