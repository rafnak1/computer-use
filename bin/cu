import select
import signal
import stat
import struct
import subprocess
import sys
import tempfile
import time
import zlib

VERSION = "1.0.0"

MAX_WAIT_SECONDS = 60.0
MAX_SCROLL_TICKS = 50
MAX_CLICK_COUNT = 5
MAX_TEXT_LENGTH = 10000
MAX_HOVER_SECONDS = 5.0
DEFAULT_HOVER = 0.15  # pause over the target before clicking (menus, pickers, tabs)
CLICK_SETTLE = 0.03  # minimum gap between the move and the press
KEY_DELAY = 0.012  # seconds between synthetic key events
CLICK_INTERVAL = 0.08
SCROLL_INTERVAL = 0.03
OPEN_TAB_SETTLE = 0.5
KEYMAP_SETTLE = 0.05  # seconds for clients to process MappingNotify
KEYMAP_LOCK_TIMEOUT = 30.0
INPUT_LOCK_TIMEOUT = 5.0  # seconds to wait for another cu process to finish its input
CLIPBOARD_TIMEOUT = 3.0  # seconds the selection owner may stay silent
MAX_CLIPBOARD_BYTES = 64 * 1024 * 1024
DEFAULT_WAIT_TIMEOUT = 10.0
DEFAULT_STABLE_SECONDS = 0.5
WAIT_POLL_INTERVAL = 0.1
SELECTION_PROBE_TIMEOUT = 0.5  # per request while polling the clipboard
MAX_STABLE_TOLERANCE = 10 ** 7

EXIT_RUNTIME = 1
EXIT_USAGE = 2

HELP_EPILOG = """\
quick start:
  cu info                         focused window, display size, pointer
  cu observe /tmp/state.png       info + screenshot in one call
  cu click 500 300                left click at desktop pixel (500, 300)
                                  (hovers %(hover)g s first; --hover 0 clicks at once)
  cu type "hello"                 literal text (clipboard untouched)
  cu key ctrl+l                   key chord
  cu scroll down 3                wheel ticks at the current pointer
  cu key Return --wait-for title-change   act, then wait for the window title to change
  cu wait --stable                wait until the screen stops changing
  cu open-tab https://example.com --wait-for title-change
                                  Ctrl+T, type URL, Enter (focused browser), wait
  cu type hi --expect-title Form  only if the active window's title contains Form
  cu clipboard                    read copied text: {"text": ..., "length": N}
  cu batch actions.json           run a JSON action list ("-" = stdin)

coordinates:
  Screenshots are native desktop pixels with (0, 0) at the top-left.
  Click/move coordinates use the same pixels; no scaling is applied.

viewing screenshots:
  The CLI only writes PNG files. Open the returned path with your image
  viewer tool and look at it before deciding the next action. An exit code
  of 0 means the input was sent, not that the application reacted.

keys:
  Chords join names with "+": ctrl+l, ctrl+shift+Tab, alt+Left, Return,
  Escape, F5, super. Modifiers: ctrl, shift, alt, super (aliases: control,
  win, meta, cmd). Use `type` for literal text and `key` for shortcuts.

access:
  Needs an unlocked X11 session reachable through $DISPLAY (default :0) and,
  if required, $XAUTHORITY. Sandboxed agents may need escalated permissions
  for desktop commands; the error message says so when the display fails.

timing (wait for a condition instead of guessing sleeps):
  Exit code 0 means the input was sent, not that the app reacted. Conditions
  are polled every %(poll)g s until met or --timeout (default %(timeout)g s):
    title-change           the active window's title differs (page loaded,
                           next listing, "Save As" dialog). Most reliable.
    title-contains=TEXT    the title contains TEXT (title-matches=REGEX too)
    window-change          another window became active (dialogs, new windows)
    stable[=SECONDS]       the screen did not change for SECONDS (default %(stable)g)
    clipboard-change[=primary]  something new was copied
  Add one to an input action with --wait-for: the value is recorded before
  the action (open-tab: just before Enter), so a fast change is not missed:
    cu key Return --wait-for title-change
    cu key ctrl+c --wait-for clipboard-change
    cu click 500 300 --wait-for window-change --timeout 5
  `cu wait --title-change` alone starts from the current title and misses a
  change that already happened; `cu wait --title-contains Example` and
  `cu wait --stable` have no such race. On timeout: exit 1, wait_timeout,
  with elapsed and the last value seen. Spinners, video and blinking cursors
  can keep stable from settling: --tolerance PIXELS ignores small changes.
  A title can change before the page finishes drawing; observe to check.

one process at a time (the input lock):
  key, type, click, move, scroll, open-tab and a batch that contains any of
  them take a lock for this user and display, until they end (waits and the
  final screenshot included). If another cu process holds it for more than %(lock)g s:
  exit 1, code busy with holder_pid (informative), nothing sent. info,
  observe, screenshot, clipboard and wait never take it. Separate commands
  from two processes can still alternate: use one batch for a sequence.
  It does not stop a person, other users or other tools.

check the window first:
  cu key ctrl+w --expect-class firefox --expect-title "Example"
  --expect-title TEXT   the active window's title contains TEXT (case-sensitive)
  --expect-class CLASS  its WM class or instance contains CLASS (any case)
  Both must hold if both are given; no active window is a mismatch. Checked
  right before the first event. On mismatch: exit 1, unexpected_window with
  expected and active_window, nothing sent. On `cu batch` they apply before
  EVERY input action; an item's "expect_title"/"expect_class" overrides them
  and null turns one off for that item (steps inside a dialog).
  open-tab always needs a known browser (Firefox and Chromium families) that
  is not a dialog; an explicit class replaces the browser list, while null
  goes back to it. Dialogs such as file pickers are refused either way.
  A browser's dialogs share its class, and Firefox's repeat the page title
  ("File Upload - Example — Mozilla Firefox"). To stop at them, use
  --expect-class Navigator (Firefox main windows) or the title (Chromium).
  This checks the ACTIVE window: a click goes to whatever is under the
  pointer, and focus can change after the check (a long type).

batch JSON (array of objects, run in order, stop on first failure):
  {"action":"info"}
  {"action":"observe", "path":"/tmp/s.png"}         path optional
  {"action":"screenshot", "path":"/tmp/s.png"}      path optional
  {"action":"open-tab", "url":"https://example.com"}
  {"action":"key", "keys":"ctrl+f"}
  {"action":"type", "text":"example"}
  {"action":"click", "x":500, "y":300, "button":"left", "count":1, "hover":%(hover)g}
  {"action":"move", "x":500, "y":300}
  {"action":"scroll", "direction":"down", "amount":3}
  {"action":"wait", "seconds":0.5}
  {"action":"wait", "until":"title-change", "timeout":10}    or any condition
     change conditions start from the value before the PREVIOUS action;
     "from":"Old title" (title-change) or "from":"0x1a00003" (window-change)
     sets it explicitly; "tolerance":N for stable
  {"action":"clipboard", "selection":"clipboard", "out":"/tmp/c.txt"}  both optional
  Input actions (open-tab, key, type, click, move, scroll) also accept
  "wait_for":"title-change", "timeout":10, "tolerance":N, and
  "expect_title":"Example", "expect_class":"firefox" (null = no check).
  Options: cu batch FILE --screenshot /tmp/final.png captures the end state;
  --expect-title / --expect-class set defaults for all input actions.

reading text (instead of scroll-and-screenshot loops):
  Select and copy, wait until the app takes the clipboard, then read:
    cu key ctrl+a; cu key ctrl+c --wait-for clipboard-change
    cu clipboard --out /tmp/page.txt
  Whole page text in Firefox (Chrome: ctrl+shift+j), via the devtools console
  (F12 closes it again):
    cu key ctrl+shift+k; cu wait 1; cu type 'copy(document.body.innerText)'
    cu key Return --wait-for clipboard-change; cu key F12
    cu clipboard --out /tmp/page.txt
  Add --expect-class so the keys go to the right window. clipboard_empty
  means nothing is copied; an unchanged clipboard still holds the old text.

limits:
  wait and --timeout 0..%(wait)g s, scroll 1..%(scroll)d ticks, click count 1..%(clicks)d,
  click hover 0..%(max_hover)g s, text up to %(text)d characters,
  clipboard up to %(clip)d MiB, owner silent for at most %(clip_timeout)g s.
  No DOM, OCR or network-idle detection; the title is the best load signal.
""" % {"wait": MAX_WAIT_SECONDS, "lock": INPUT_LOCK_TIMEOUT, "poll": WAIT_POLL_INTERVAL, "timeout": DEFAULT_WAIT_TIMEOUT,
       "stable": DEFAULT_STABLE_SECONDS, "scroll": MAX_SCROLL_TICKS,
       "clicks": MAX_CLICK_COUNT, "text": MAX_TEXT_LENGTH,
       "hover": DEFAULT_HOVER, "max_hover": MAX_HOVER_SECONDS,
       "clip": MAX_CLIPBOARD_BYTES // (1024 * 1024), "clip_timeout": CLIPBOARD_TIMEOUT}


class CuError(Exception):
    """An error reported to the caller as structured JSON."""

    def __init__(self, code, message, hint=None, exit_code=EXIT_RUNTIME, **extra):
        super().__init__(message)
        self.code = code
        self.message = message
        self.hint = hint
        self.exit_code = exit_code
        self.extra = extra

    def to_json(self):
        err = {"code": self.code, "message": self.message}
        if self.hint:
            err["hint"] = self.hint
        err.update(self.extra)
        return err


def usage_error(message, hint=None, **extra):
    return CuError("invalid_argument", message, hint, exit_code=EXIT_USAGE, **extra)


